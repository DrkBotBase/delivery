<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-50">
    <div class="flex h-screen">
        <!-- Sidebar -->
        <div class="w-64 bg-indigo-800 text-white flex flex-col">
            <div class="p-5 border-b border-indigo-700">
                <h1 class="text-xl font-bold"><i class="fas fa-store"></i> Admin Panel</h1>
                <p class="text-xs text-indigo-300 mt-1"><%= admin.fullName || admin.username %></p>
            </div>
            <nav class="flex-1 p-4">
                <a href="/admin" class="flex items-center gap-3 px-4 py-3 hover:bg-indigo-700 rounded-lg transition">
                    <i class="fas fa-chart-line"></i> Dashboard
                </a>
                <a href="/admin/restaurants" class="flex items-center gap-3 px-4 py-3 hover:bg-indigo-700 rounded-lg transition">
                    <i class="fas fa-store"></i> Restaurantes
                </a>
                <a href="/admin/recharges" class="flex items-center gap-3 px-4 py-3 bg-indigo-700 rounded-lg">
                    <i class="fas fa-history"></i> Historial de Recargas
                </a>
            </nav>
            <div class="p-4 border-t border-indigo-700">
                <a href="/auth/logout" class="flex items-center gap-3 px-4 py-3 hover:bg-indigo-700 rounded-lg transition">
                    <i class="fas fa-sign-out-alt"></i> Cerrar Sesión
                </a>
            </div>
        </div>
        
        <!-- Main content -->
        <div class="flex-1 overflow-auto">
            <header class="bg-white shadow-sm p-6">
                <h2 class="text-2xl font-bold text-gray-800">Historial de Recargas</h2>
                <p class="text-gray-500 text-sm">Registro de todas las recargas de escaneos realizadas</p>
            </header>
            
            <main class="p-6">
                <!-- Resumen -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-2xl p-6 text-white">
                        <p class="text-indigo-100 text-sm">Total Recargas</p>
                        <p class="text-3xl font-bold"><%= pagination.total %></p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <p class="text-gray-400 text-sm">Última recarga</p>
                        <p class="text-lg font-bold text-gray-800">
                            <% if (recharges.length > 0) { %>
                                <%= new Date(recharges[0].createdAt).toLocaleDateString() %>
                            <% } else { %>
                                Sin registros
                            <% } %>
                        </p>
                    </div>
                    <div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100">
                        <p class="text-gray-400 text-sm">Administradores activos</p>
                        <p class="text-lg font-bold text-gray-800">
                            <% 
                            var adminsUnicos = [];
                            recharges.forEach(function(r) {
                                if (adminsUnicos.indexOf(r.adminName) === -1) adminsUnicos.push(r.adminName);
                            });
                            %>
                            <%= adminsUnicos.length %>
                        </p>
                    </div>
                </div>
                
                <!-- Tabla de recargas -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead class="bg-gray-50 border-b border-gray-100">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Fecha</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Restaurante</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Cantidad</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Anterior</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Nuevo Total</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Admin</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Notas</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-100">
                                <% if (recharges.length === 0) { %>
                                    <tr>
                                        <td colspan="8" class="px-6 py-12 text-center text-gray-400">
                                            <i class="fas fa-history text-4xl mb-2"></i>
                                            <p>No hay recargas registradas</p>
                                            <p class="text-sm mt-1">Las recargas aparecerán aquí cuando se realicen</p>
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% recharges.forEach(function(recharge) { %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-6 py-4 text-sm text-gray-600 whitespace-nowrap">
                                                <%= new Date(recharge.createdAt).toLocaleString() %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div>
                                                    <p class="font-medium text-gray-800"><%= recharge.restaurantName %></p>
                                                    <a href="/admin/restaurants/<%= recharge.restaurantId %>" class="text-xs text-indigo-600 hover:underline">
                                                        Ver detalles
                                                    </a>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="font-mono text-xs bg-gray-100 px-2 py-1 rounded"><%= recharge.pointId %></span>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 px-2 py-1 rounded-full text-sm font-semibold">
                                                    <i class="fas fa-plus-circle text-xs"></i> +<%= recharge.amount %>
                                                </span>
                                            </td>
                                            <td class="px-6 py-4 text-center text-sm text-gray-500">
                                                <%= recharge.previousScans %>
                                            </td>
                                            <td class="px-6 py-4 text-center font-semibold text-gray-800">
                                                <%= recharge.newScans %>
                                            </td>
                                            <td class="px-6 py-4">
                                                <div class="flex items-center gap-2">
                                                    <div class="w-6 h-6 bg-indigo-100 rounded-full flex items-center justify-center">
                                                        <i class="fas fa-user-shield text-indigo-600 text-xs"></i>
                                                    </div>
                                                    <span class="text-sm text-gray-600"><%= recharge.adminName %></span>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4 text-sm text-gray-500 max-w-xs truncate" title="<%= recharge.notes || '' %>">
                                                <%= recharge.notes || '-' %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                    
                    <!-- Paginación -->
                    <% if (pagination.pages > 1) { %>
                        <div class="px-6 py-4 border-t border-gray-100 flex justify-between items-center">
                            <p class="text-sm text-gray-500">
                                Mostrando <%= recharges.length %> de <%= pagination.total %> recargas
                            </p>
                            <div class="flex gap-2">
                                <% if (pagination.page > 1) { %>
                                    <a href="?page=<%= pagination.page - 1 %>" class="px-3 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                <% } %>
                                
                                <% 
                                var startPage = Math.max(1, pagination.page - 2);
                                var endPage = Math.min(pagination.pages, pagination.page + 2);
                                for (var i = startPage; i <= endPage; i++) { 
                                %>
                                    <a href="?page=<%= i %>" 
                                       class="px-3 py-1 rounded <%= i === pagination.page ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                                
                                <% if (pagination.page < pagination.pages) { %>
                                    <a href="?page=<%= pagination.page + 1 %>" class="px-3 py-1 rounded bg-gray-100 text-gray-600 hover:bg-gray-200">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    <% } %>
                </div>
                
                <!-- Exportar datos -->
                <div class="mt-6 flex justify-end">
                    <button onclick="exportToCSV()" class="bg-gray-100 text-gray-700 px-4 py-2 rounded-lg hover:bg-gray-200">
                        <i class="fas fa-download"></i> Exportar a CSV
                    </button>
                </div>
            </main>
        </div>
    </div>
    
    <script>
        function exportToCSV() {
            // Recopilar datos de la tabla
            const rows = document.querySelectorAll('tbody tr');
            let csv = 'Fecha,Restaurante,ID,Cantidad,Anterior,Nuevo Total,Admin,Notas\n';
            
            rows.forEach(function(row) {
                // Saltar fila de "no hay registros"
                if (row.querySelector('td[colspan]')) return;
                
                const cells = row.querySelectorAll('td');
                if (cells.length >= 7) {
                    const fecha = cells[0].innerText.replace(/,/g, ';');
                    const restaurante = cells[1].innerText.replace(/,/g, ';').split('Ver detalles')[0];
                    const id = cells[2].innerText;
                    const cantidad = cells[3].innerText.replace(/\+/g, '').replace(/,/g, '');
                    const anterior = cells[4].innerText;
                    const nuevo = cells[5].innerText;
                    const admin = cells[6].innerText.replace(/,/g, ';');
                    const notas = cells[7] ? cells[7].innerText.replace(/,/g, ';') : '';
                    
                    csv += `"${fecha}","${restaurante}","${id}","${cantidad}","${anterior}","${nuevo}","${admin}","${notas}"\n`;
                }
            });
            
            // Descargar archivo
            const blob = new Blob([csv], { type: 'text/csv' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `recargas_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            
            Swal.fire('Éxito', 'Archivo CSV exportado correctamente', 'success');
        }
    </script>
</body>
</html>