<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .preview-card {
            transition: all 0.3s ease;
            max-width: 380px;
            margin: 0 auto;
        }
        .preview-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/panel" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="text-xl font-bold">Panel de Notificaciones</h1>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-sm"><%= admin.username %></span>
                <button onclick="confirmLogout()" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <div class="bg-white rounded-2xl shadow-sm p-6">
                <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-edit text-indigo-500"></i> Crear Notificación
                </h2>
                
                <form id="notificationForm" class="space-y-4">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-heading text-gray-400 mr-1"></i> Título *
                        </label>
                        <input type="text" id="title" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                               placeholder="Ej: 🚀 Nueva Actualización Disponible" required>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-tag text-gray-400 mr-1"></i> Tipo
                        </label>
                        <select id="type" class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500">
                            <option value="info">ℹ️ Información</option>
                            <option value="success">✅ Éxito / Logro</option>
                            <option value="warning">⚠️ Advertencia / Alerta</option>
                            <option value="promotion">🎉 Promoción / Oferta</option>
                            <option value="update">🔄 Actualización</option>
                        </select>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-message text-gray-400 mr-1"></i> Mensaje corto *
                        </label>
                        <textarea id="message" rows="2" 
                                  class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500"
                                  placeholder="Mensaje breve que resume la notificación..." required></textarea>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-image text-gray-400 mr-1"></i> URL del Banner (opcional)
                        </label>
                        <input type="text" id="imageUrl" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500"
                               placeholder="url de la imagen a usar">
                        <p class="text-xs text-gray-400 mt-1">
                            <i class="fas fa-info-circle"></i> Imagen de cabecera (recomendado: 760x200px)
                        </p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-code text-gray-400 mr-1"></i> Contenido
                        </label>
                        <div class="space-y-2">
                            <select id="contentTemplate" class="w-full px-4 py-2 border border-gray-300 rounded-xl text-sm" onchange="applyTemplate()">
                                <option value="">-- Seleccionar plantilla --</option>
                                <option value="update">🚀 Plantilla de Actualización</option>
                                <option value="promotion">🎉 Plantilla de Promoción</option>
                                <option value="info">ℹ️ Plantilla de Información</option>
                                <option value="warning">⚠️ Plantilla de Alerta</option>
                                <option value="achievement">🏆 Plantilla de Logro</option>
                                <option value="reminder">⏰ Plantilla de Recordatorio</option>
                                <option value="maintenance">🔧 Plantilla de Mantenimiento</option>
                            </select>
                            <textarea id="content" rows="6" 
                                      class="w-full px-4 py-2 border border-gray-300 rounded-xl font-mono text-sm focus:ring-2 focus:ring-indigo-500"
                                      placeholder="Contenido HTML de la notificación..."></textarea>
                            <p class="text-xs text-gray-400">
                                <i class="fas fa-info-circle"></i> Puedes escribir HTML directamente o seleccionar una plantilla
                            </p>
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-link text-gray-400 mr-1"></i> Enlace (opcional)
                        </label>
                        <input type="url" id="link" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500"
                               placeholder="https://...">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-1">
                            <i class="fas fa-calendar-times text-gray-400 mr-1"></i> Expira (opcional)
                        </label>
                        <input type="datetime-local" id="expiresAt" 
                               class="w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-indigo-500">
                    </div>
                    
                    <div class="flex gap-3 pt-2">
                        <button type="submit" class="flex-1 bg-indigo-600 text-white py-2.5 rounded-xl font-bold hover:bg-indigo-700 transition">
                            <i class="fas fa-paper-plane mr-2"></i> Enviar Notificación
                        </button>
                        <button type="button" onclick="previewNotification()" class="px-4 bg-gray-100 text-gray-700 rounded-xl font-bold hover:bg-gray-200 transition">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </form>
            </div>
            
            <div class="bg-white rounded-2xl shadow-sm p-6">
                <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                    <i class="fas fa-eye text-indigo-500"></i> Vista Previa
                </h2>
                <div id="previewContainer" class="preview-card bg-gray-50 rounded-xl p-4 min-h-[300px]">
                    <p class="text-center text-gray-400 text-sm">
                        <i class="fas fa-magic"></i> Completa el formulario para ver la vista previa
                    </p>
                </div>
            </div>
        </div>
        
        <div class="mt-8 bg-white rounded-2xl shadow-sm p-6">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                    <i class="fas fa-history text-indigo-500"></i> Notificaciones Enviadas
                </h2>
                <button onclick="loadNotificationsList()" class="text-indigo-500 hover:text-indigo-700">
                    <i class="fas fa-sync-alt"></i>
                </button>
            </div>
            
            <div id="notificationsList" class="space-y-3 max-h-[500px] overflow-y-auto">
                <div class="text-center py-8 text-gray-400">
                    <i class="fas fa-spinner fa-spin"></i> Cargando...
                </div>
            </div>
            
            <div id="pagination" class="flex justify-center gap-2 mt-4"></div>
        </div>
    </main>

    <script>
        let currentPage = 1;
        
        const templates = {
            update: (title, message) => `
<div class="space-y-3">
    <div class="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl p-4 text-white text-center">
        <i class="fas fa-rocket text-2xl mb-1"></i>
        <p class="font-bold">¡Nueva Actualización!</p>
    </div>
    <div>
        <p class="font-bold text-gray-800">✨ Novedades:</p>
        <ul class="mt-2 space-y-1 text-sm text-gray-600 list-disc list-inside">
            <li>Escribe aquí las novedades...</li>
            <li>Agrega los cambios importantes</li>
        </ul>
    </div>
    <div class="bg-yellow-50 p-3 rounded-lg text-center">
        <p class="text-xs text-yellow-700">Cierra y vuelve a abrir la app para actualizar</p>
    </div>
</div>`,
            
            promotion: (title, message) => `
<div class="space-y-3 text-center">
    <div class="bg-gradient-to-r from-pink-500 to-orange-500 rounded-xl p-4 text-white">
        <i class="fas fa-gift text-2xl mb-1"></i>
        <p class="font-bold text-2xl">${message.split(' ').slice(0,3).join(' ') || 'OFERTA'}</p>
    </div>
    <p class="text-gray-600 text-sm">${message}</p>
    <div class="bg-gray-100 rounded-xl p-2">
        <p class="font-mono font-bold text-indigo-600">USA EL CÓDIGO: PROMO2024</p>
    </div>
</div>`,
            
            info: (title, message) => `
<div class="space-y-3">
    <div class="flex items-center gap-3 pb-2 border-b border-gray-200">
        <i class="fas fa-info-circle text-blue-500 text-xl"></i>
        <p class="font-bold text-gray-800">${title}</p>
    </div>
    <p class="text-gray-600 text-sm leading-relaxed">${message}</p>
</div>`,
            
            warning: (title, message) => `
<div class="space-y-3">
    <div class="bg-red-50 border-l-4 border-red-500 rounded-xl p-3">
        <div class="flex items-start gap-2">
            <i class="fas fa-exclamation-triangle text-red-500 mt-0.5"></i>
            <p class="text-sm text-red-700">${message}</p>
        </div>
    </div>
</div>`,
            
            achievement: (title, message) => `
<div class="space-y-3 text-center">
    <div class="w-16 h-16 mx-auto bg-gradient-to-br from-yellow-400 to-orange-500 rounded-full flex items-center justify-center">
        <i class="fas fa-trophy text-white text-2xl"></i>
    </div>
    <h3 class="font-bold text-gray-800 text-lg">¡Felicidades!</h3>
    <p class="text-gray-600 text-sm">${message}</p>
</div>`,
            
            reminder: (title, message) => `
<div class="space-y-3">
    <div class="flex items-center gap-3 bg-orange-50 rounded-xl p-3">
        <i class="fas fa-clock text-orange-500 text-xl"></i>
        <div>
            <p class="font-bold text-gray-800">Recordatorio</p>
            <p class="text-sm text-gray-600">${message}</p>
        </div>
    </div>
</div>`,
            
            maintenance: (title, message) => `
<div class="space-y-3">
    <div class="bg-yellow-50 rounded-xl p-4 text-center">
        <i class="fas fa-tools text-yellow-600 text-2xl mb-2"></i>
        <p class="font-bold text-gray-800">Mantenimiento Programado</p>
        <p class="text-sm text-gray-600 mt-1">${message}</p>
        <p class="text-xs text-gray-400 mt-2">Gracias por tu comprensión</p>
    </div>
</div>`
        };
        
        function applyTemplate() {
            const template = document.getElementById('contentTemplate').value;
            const title = document.getElementById('title').value;
            const message = document.getElementById('message').value;
            
            if (template && templates[template]) {
                const html = templates[template](title, message);
                document.getElementById('content').value = html;
                previewNotification();
            }
        }
        
        function previewNotification() {
            const title = document.getElementById('title').value || 'Título de ejemplo';
            const message = document.getElementById('message').value || 'Mensaje de ejemplo';
            const type = document.getElementById('type').value;
            const content = document.getElementById('content').value;
            
            const container = document.getElementById('previewContainer');
            
            const typeColors = {
                info: 'bg-blue-50 border-blue-300',
                success: 'bg-green-50 border-green-300',
                warning: 'bg-red-50 border-red-300',
                promotion: 'bg-pink-50 border-pink-300',
                update: 'bg-purple-50 border-purple-300'
            };
            
            const typeIcons = {
                info: 'fa-info-circle text-blue-500',
                success: 'fa-check-circle text-green-500',
                warning: 'fa-exclamation-triangle text-red-500',
                promotion: 'fa-tag text-pink-500',
                update: 'fa-sync-alt text-purple-500'
            };
            
            let html = `
                <div class="rounded-xl border ${typeColors[type] || 'bg-gray-50 border-gray-200'} p-4">
                    <div class="flex items-start gap-3 mb-3">
                        <i class="fas ${typeIcons[type] || 'fa-bell'} text-xl"></i>
                        <div class="flex-1">
                            <h3 class="font-bold text-gray-800">${escapeHtml(title)}</h3>
                            <p class="text-xs text-gray-500">Ahora mismo</p>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mb-3">${escapeHtml(message)}</p>
            `;
            
            if (content) {
                html += `<div class="mt-3 pt-3 border-t border-gray-200 text-sm">${content}</div>`;
            }
            
            html += `</div>`;
            
            container.innerHTML = html;
        }
        
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        async function createNotification() {
            const formData = {
                title: document.getElementById('title').value,
                type: document.getElementById('type').value,
                message: document.getElementById('message').value,
                content: document.getElementById('content').value,
                link: document.getElementById('link').value,
                imageUrl: document.getElementById('imageUrl').value,
                expiresAt: document.getElementById('expiresAt').value || null
            };
            
            if (!formData.title || !formData.message) {
                Swal.fire('Error', 'Título y mensaje son requeridos', 'error');
                return;
            }
            
            try {
                const response = await fetch('/api/notifications/admin', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                
                const data = await response.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Notificación enviada',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    document.getElementById('notificationForm').reset();
                    document.getElementById('content').value = '';
                    document.getElementById('previewContainer').innerHTML = '<p class="text-center text-gray-400 text-sm"><i class="fas fa-magic"></i> Completa el formulario para ver la vista previa</p>';
                    loadNotificationsList();
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'No se pudo crear', 'error');
            }
        }
        
        async function loadNotificationsList(page = 1) {
            currentPage = page;
            try {
                const response = await fetch(`/api/notifications/admin?page=${page}&limit=10`);
                const data = await response.json();
                
                if (data.success) {
                    renderNotificationsList(data.notifications);
                    renderPagination(data.pagination);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }
        
        function renderNotificationsList(notifications) {
            const container = document.getElementById('notificationsList');
            
            if (notifications.length === 0) {
                container.innerHTML = `<div class="text-center py-8 text-gray-400"><i class="fas fa-bell-slash text-3xl mb-2"></i><p>No hay notificaciones</p></div>`;
                return;
            }
            
            container.innerHTML = notifications.map(notif => `
                <div class="border border-gray-200 rounded-xl p-4 hover:shadow-md transition">
                    <div class="flex justify-between items-start">
                        <div class="flex items-center gap-2">
                            <span class="text-xs px-2 py-1 rounded-full ${getStatusClass(notif.isActive)}">
                                ${notif.isActive ? 'Activa' : 'Inactiva'}
                            </span>
                            <span class="text-xs text-gray-500">${new Date(notif.createdAt).toLocaleString()}</span>
                        </div>
                        <button onclick="deleteNotification('${notif._id}')" class="text-red-500 hover:text-red-700">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                    <h3 class="font-bold text-gray-800 mt-2">${escapeHtml(notif.title)}</h3>
                    <p class="text-sm text-gray-600 mt-1">${escapeHtml(notif.message)}</p>
                    <div class="mt-2 text-xs text-gray-400">
                        <i class="fas fa-users"></i> Leída por: ${notif.readBy?.length || 0} usuarios
                    </div>
                </div>
            `).join('');
        }
        
        function renderPagination(pagination) {
            const container = document.getElementById('pagination');
            if (pagination.totalPages <= 1) {
                container.innerHTML = '';
                return;
            }
            
            let html = '';
            for (let i = 1; i <= pagination.totalPages; i++) {
                html += `<button onclick="loadNotificationsList(${i})" class="px-3 py-1 rounded-lg ${i === currentPage ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-700'}">${i}</button>`;
            }
            container.innerHTML = html;
        }
        
        async function deleteNotification(id) {
            const result = await Swal.fire({
                title: '¿Eliminar notificación?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                confirmButtonText: 'Sí, eliminar'
            });
            
            if (result.isConfirmed) {
                await fetch(`/api/notifications/admin/${id}`, { method: 'DELETE' });
                Swal.fire('Eliminada', '', 'success');
                loadNotificationsList();
            }
        }
        
        function getStatusClass(isActive) {
            return isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500';
        }
        
        document.getElementById('notificationForm').addEventListener('submit', (e) => {
            e.preventDefault();
            createNotification();
        });
        
        document.getElementById('title').addEventListener('input', previewNotification);
        document.getElementById('message').addEventListener('input', previewNotification);
        document.getElementById('type').addEventListener('change', previewNotification);
        document.getElementById('content').addEventListener('input', previewNotification);
        
        loadNotificationsList();
    </script>
</body>
</html>