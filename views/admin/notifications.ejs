<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .ql-editor { min-height: 150px; }
    </style>
</head>
<body class="bg-gray-50 antialiased min-h-screen">
    <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

    <div class="flex h-screen overflow-hidden">
        <aside id="sidebar" class="fixed inset-y-0 left-0 w-64 bg-indigo-800 text-white flex flex-col z-50 transform -translate-x-full transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0">
          <%- include("p-sidebar") %>
        </aside>
        
        <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
            <header class="bg-white shadow-sm p-4 lg:p-6 flex items-center justify-between sticky top-0 z-40">
                <div class="flex items-center gap-4">
                    <button id="openSidebar" class="lg:hidden p-2 text-gray-600 hover:bg-gray-100 rounded-md">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h2 class="text-xl lg:text-2xl font-bold text-gray-800">Notificaciones</h2>
                        <p class="hidden sm:block text-gray-500 text-sm">Comunícate con los restaurantes y repartidores</p>
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-y-auto p-4 lg:p-6">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sticky lg:top-4">
                            <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                                <i class="fas fa-plus-circle text-indigo-500"></i> <span id="formTitle">Nueva Notificación</span>
                            </h2>
                            
                            <form id="notificationForm" class="space-y-4">
                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Título *</label>
                                    <input type="text" id="title" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition" placeholder="Ej: Actualización de sistema" required>
                                </div>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Tipo</label>
                                        <select id="type" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none transition bg-white">
                                            <option value="info">ℹ️ Info</option>
                                            <option value="success">✅ Éxito</option>
                                            <option value="warning">⚠️ Alerta</option>
                                            <option value="promotion">🎉 Promo</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Icono FontAwesome</label>
                                        <input type="text" id="customIcon" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="fas fa-star">
                                    </div>
                                </div>

                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Resumen Mensaje *</label>
                                    <textarea id="message" rows="2" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Breve descripción..." required></textarea>
                                </div>
                                
                                <div>
                                    <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Cuerpo (HTML / Quill)</label>
                                    <div id="editor" class="rounded-xl overflow-hidden" style="height: 150px;"></div>
                                </div>
                                
                                <div class="space-y-4 pt-2">
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Imagen URL</label>
                                        <input type="url" id="imageUrl" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="https://...">
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-gray-400 uppercase mb-1">Fecha Expiración</label>
                                        <input type="datetime-local" id="expiresAt" class="w-full px-4 py-2.5 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                                    </div>
                                </div>
                                
                                <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold shadow-lg shadow-indigo-100 hover:bg-indigo-700 transition flex items-center justify-center gap-2">
                                    <i class="fas fa-paper-plane"></i> <span id="submitBtnText">Enviar Notificación</span>
                                </button>
                                <button type="button" id="cancelEdit" class="hidden w-full bg-gray-100 text-gray-600 py-2 rounded-xl font-bold mt-2">Cancelar Edición</button>
                            </form>
                        </div>
                    </div>
                    
                    <div class="lg:col-span-2">
                        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                            <div class="flex justify-between items-center mb-6">
                                <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                                    <i class="fas fa-history text-indigo-500"></i> Historial de Envíos
                                </h2>
                                <button onclick="loadNotificationsList()" class="p-2 text-indigo-500 hover:bg-indigo-50 rounded-full transition">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            
                            <div id="notificationsList" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="col-span-full text-center py-12 text-gray-400">
                                    <i class="fas fa-circle-notch fa-spin text-3xl mb-2"></i>
                                    <p>Cargando notificaciones...</p>
                                </div>
                            </div>
                            
                            <div id="pagination" class="flex justify-center gap-2 mt-8"></div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>


    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const openBtn = document.getElementById('openSidebar');
        const closeBtn = document.getElementById('closeSidebar');

        const toggleSidebar = () => {
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        };

        openBtn.addEventListener('click', toggleSidebar);
        closeBtn.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', toggleSidebar);

        let quill;
        let currentPage = 1;
        let editingId = null;

        document.addEventListener('DOMContentLoaded', () => {
            quill = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'Detalles adicionales...',
                modules: { toolbar: [['bold', 'italic'], ['link', 'image'], [{ 'list': 'bullet' }]] }
            });
            loadNotificationsList();
        });

        async function loadNotificationsList(page = 1) {
            currentPage = page;
            try {
                const response = await fetch(`/api/notifications/admin?page=${page}&limit=10`);
                const data = await response.json();
                if (data.success) {
                    renderNotificationsList(data.notifications);
                    renderPagination(data.pagination);
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }

        function renderNotificationsList(notifications) {
            const container = document.getElementById('notificationsList');
            if (!notifications.length) {
                container.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400 italic">No hay notificaciones enviadas.</div>`;
                return;
            }

            container.innerHTML = notifications.map(notif => `
                <div class="flex flex-col bg-white border border-gray-100 rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition">
                    ${notif.imageUrl ? `<img src="${notif.imageUrl}" class="w-full h-32 object-cover" onerror="this.style.display='none'">` : ''}
                    <div class="p-4 flex-1">
                        <div class="flex justify-between items-start mb-2">
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider ${notif.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}">
                                ${notif.type}
                            </span>
                            <div class="flex gap-2">
                                <button onclick="editNotification('${notif._id}')" class="text-indigo-600 hover:bg-indigo-50 p-1.5 rounded-lg transition"><i class="fas fa-edit"></i></button>
                                <button onclick="deleteNotification('${notif._id}')" class="text-red-500 hover:bg-red-50 p-1.5 rounded-lg transition"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                        <h3 class="font-bold text-gray-800 text-sm truncate">${notif.title}</h3>
                        <p class="text-xs text-gray-500 mt-1 line-clamp-2">${notif.message}</p>
                        <p class="text-[10px] text-gray-400 mt-3"><i class="far fa-clock mr-1"></i>${new Date(notif.createdAt).toLocaleDateString()}</p>
                    </div>
                </div>
            `).join('');
        }

        function getFormData() {
            return {
                title: document.getElementById('title').value,
                type: document.getElementById('type').value,
                customIcon: document.getElementById('customIcon').value,
                message: document.getElementById('message').value,
                content: quill.root.innerHTML,
                imageUrl: document.getElementById('imageUrl').value,
                expiresAt: document.getElementById('expiresAt').value || null,
                isActive: true
            };
        }

        document.getElementById('notificationForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = getFormData();
            const url = editingId ? `/api/notifications/admin/${editingId}` : '/api/notifications/admin';
            const method = editingId ? 'PUT' : 'POST';

            try {
                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });
                const data = await res.json();

                if (data.success) {
                    Swal.fire('Éxito', editingId ? 'Actualizada' : 'Enviada', 'success');
                    resetForm();
                    loadNotificationsList();
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Fallo de conexión', 'error');
            }
        });

        async function editNotification(id) {
            const res = await fetch(`/api/notifications/admin/${id}`);
            const data = await res.json();
            if (data.success) {
                const n = data.notification;
                editingId = id;
                document.getElementById('title').value = n.title;
                document.getElementById('type').value = n.type;
                document.getElementById('message').value = n.message;
                document.getElementById('customIcon').value = n.customIcon || '';
                document.getElementById('imageUrl').value = n.imageUrl || '';
                quill.clipboard.dangerouslyPasteHTML(n.content || '');
                
                document.getElementById('formTitle').innerText = "Editando Notificación";
                document.getElementById('submitBtnText').innerText = "Actualizar";
                document.getElementById('cancelEdit').classList.remove('hidden');
                document.querySelector('main').scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function resetForm() {
            document.getElementById('notificationForm').reset();
            quill.setContents([]);
            editingId = null;
            document.getElementById('formTitle').innerText = "Nueva Notificación";
            document.getElementById('submitBtnText').innerText = "Enviar Notificación";
            document.getElementById('cancelEdit').classList.add('hidden');
        }

        document.getElementById('cancelEdit').addEventListener('click', resetForm);

        async function confirmLogout() {
            const r = await Swal.fire({ title: '¿Cerrar sesión?', icon: 'question', showCancelButton: true });
            if (r.isConfirmed) window.location.href = '/auth/logout';
        }

async function deleteNotification(id) {
    const result = await Swal.fire({
        title: '¿Eliminar notificación?',
        text: 'Esta acción no se puede deshacer',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    });

    if (!result.isConfirmed) return;

    try {
        const response = await fetch(`/api/notifications/admin/${id}`, {
            method: 'DELETE'
        });

        let data;
        try {
            data = await response.json();
        } catch {
            data = {};
        }

        if (!response.ok || !data.success) {
            throw new Error(data.error || 'No se pudo eliminar');
        }

        Swal.fire({
            icon: 'success',
            title: 'Eliminada',
            text: 'Notificación eliminada correctamente',
            timer: 1500,
            showConfirmButton: false
        });

        loadNotificationsList(currentPage);

    } catch (error) {
        console.error('Error eliminando:', error);

        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: error.message || 'No se pudo eliminar la notificación'
        });
    }
}

async function updateNotification(id) {
    const formData = getFormData();

    try {
        const response = await fetch(`/api/notifications/admin/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!data.success) {
            return Swal.fire('Error', data.error, 'error');
        }

        Swal.fire('Actualizada', 'Correctamente', 'success');

        resetForm();
        loadNotificationsList();

    } catch (error) {
        console.error(error);
        Swal.fire('Error', 'No se pudo actualizar', 'error');
    }
}

async function createNotification() {
    const formData = getFormData();

    try {
        const response = await fetch('/api/notifications/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!data.success) {
            return Swal.fire('Error', data.error, 'error');
        }

        Swal.fire('Creada', 'Correctamente', 'success');

        resetForm();
        loadNotificationsList();

    } catch (error) {
        console.error(error);
        Swal.fire('Error', 'No se pudo crear', 'error');
    }
}

function renderPagination(pagination) {
    const container = document.getElementById('pagination');

    if (!pagination || pagination.totalPages <= 1) {
        container.innerHTML = '';
        return;
    }

    let html = '';

    for (let i = 1; i <= pagination.totalPages; i++) {
        html += `
            <button onclick="loadNotificationsList(${i})"
                class="px-3 py-1 rounded-lg ${
                    i === currentPage
                        ? 'bg-indigo-600 text-white'
                        : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                }">
                ${i}
            </button>
        `;
    }

    container.innerHTML = html;
}

function getStatusClass(isActive) {
    return isActive
        ? 'bg-green-100 text-green-700'
        : 'bg-gray-100 text-gray-500';
}

function escapeHtml(text) {
    if (!text) return '';

    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

function cleanQuillHTML(html) {
    if (!html) return '';

    let cleaned = html;

    const textarea = document.createElement('textarea');
    textarea.innerHTML = cleaned;
    cleaned = textarea.value;

    cleaned = cleaned.replace(/<p>\s*<\/p>/g, '');
    cleaned = cleaned.replace(/<p><br><\/p>/g, '');

    cleaned = cleaned.replace(/&lt;/g, '<');
    cleaned = cleaned.replace(/&gt;/g, '>');
    cleaned = cleaned.replace(/&amp;/g, '&');
    cleaned = cleaned.replace(/&quot;/g, '"');
    cleaned = cleaned.replace(/&#39;/g, "'");

    cleaned = cleaned.replace(/^<p>(.*)<\/p>$/s, '$1');

    return cleaned;
}
    </script>
<script src="/js/app.js"></script>
</body>
</html>