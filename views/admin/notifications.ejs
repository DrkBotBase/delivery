<!-- views/admin/notifications.ejs -->
<!DOCTYPE html>
<html lang="es">
<head>
    <%- include("../partials/head") %>
    <link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
    <script src="https://cdn.quilljs.com/1.3.7/quill.js"></script>
    <style>
        .ql-editor { min-height: 150px; }
    </style>
</head>
<body class="bg-gray-50 min-h-screen">
    <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-4">
                <a href="/panel" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition">
                    <i class="fas fa-arrow-left"></i>
                </a>
                <h1 class="text-xl font-bold">Panel de Notificaciones</h1>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-sm"><%= currentUser.username %></span>
                <button onclick="confirmLogout()" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition">
                    <i class="fas fa-sign-out-alt"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 py-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Formulario para crear notificación -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl shadow-sm p-5 sticky top-20">
                    <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2">
                        <i class="fas fa-plus-circle text-indigo-500"></i> Crear Notificación
                    </h2>
                    
                    <form id="notificationForm">
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Título *</label>
                            <input type="text" id="title" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent" required>
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Tipo</label>
                            <select id="type" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                                <option value="info">ℹ️ Información</option>
                                <option value="success">✅ Éxito</option>
                                <option value="warning">⚠️ Advertencia</option>
                                <option value="promotion">🎉 Promoción</option>
                                <option value="update">🔄 Actualización</option>
                            </select>
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Ícono Personalizado (opcional)</label>
                            <div class="relative">
                                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                    <i class="fas fa-icons text-gray-400"></i>
                                </div>
                                <input type="text" id="customIcon" class="w-full pl-10 px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" placeholder="ej. fas fa-star">
                            </div>
                        </div>

                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Mensaje *</label>
                            <textarea id="message" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" required></textarea>
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Contenido HTML (opcional)</label>
                            <div id="editor"></div>
                            <input type="hidden" id="content">
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Enlace (opcional)</label>
                            <input type="url" id="link" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" placeholder="https://...">
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">URL de imagen (opcional)</label>
                            <input type="url" id="imageUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500" placeholder="https://...">
                        </div>
                        
                        <div class="mb-4">
                            <label class="block text-sm font-bold text-gray-700 mb-1">Fecha de expiración (opcional)</label>
                            <input type="datetime-local" id="expiresAt" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500">
                        </div>
                        
                        <button type="submit" class="w-full bg-indigo-600 text-white py-2 rounded-lg font-bold hover:bg-indigo-700 transition">
                            <i class="fas fa-paper-plane mr-2"></i> Enviar Notificación
                        </button>
                    </form>
                </div>
            </div>
            
            <!-- Lista de notificaciones existentes -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-sm p-5">
                    <div class="flex justify-between items-center mb-4">
                        <h2 class="text-lg font-bold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-history text-indigo-500"></i> Notificaciones Enviadas
                        </h2>
                        <button onclick="loadNotificationsList()" class="text-indigo-500 hover:text-indigo-700">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                    
                    <div id="notificationsList" class="space-y-3 max-h-[600px] overflow-y-auto">
                        <div class="text-center py-8 text-gray-400">
                            <i class="fas fa-spinner fa-spin"></i> Cargando...
                        </div>
                    </div>
                    
                    <div id="pagination" class="flex justify-center gap-2 mt-4"></div>
                </div>
            </div>
        </div>
    </main>
    
<script>
let quill;
let currentPage = 1;
let editingId = null;

// Inicializar Quill
document.addEventListener('DOMContentLoaded', () => {
    quill = new Quill('#editor', {
        theme: 'snow',
        placeholder: 'Escribe contenido HTML aquí...',
        modules: {
            toolbar: [
                ['bold', 'italic', 'underline', 'strike'],
                ['blockquote', 'code-block'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                ['link', 'image'],
                ['clean']
            ]
        }
    });

    loadNotificationsList();
});


// =============================
// SUBMIT ÚNICO (CREATE + UPDATE)
// =============================
document.getElementById('notificationForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    if (editingId) {
        await updateNotification(editingId);
    } else {
        await createNotification();
    }
});


// =============================
// EDITAR
// =============================
async function editNotification(id) {
    try {
        console.log('📝 Editando:', id);

        const response = await fetch(`/api/notifications/admin/${id}`);
        const data = await response.json();

        if (!data.success) {
            return Swal.fire('Error', data.error, 'error');
        }

        const notif = data.notification;

        editingId = id;

        // Llenar formulario
        document.getElementById('title').value = notif.title || '';
        document.getElementById('type').value = notif.type || 'info';
        document.getElementById('message').value = notif.message || '';
        document.getElementById('link').value = notif.link || '';
        document.getElementById('imageUrl').value = notif.imageUrl || '';

        if (notif.expiresAt) {
            const date = new Date(notif.expiresAt);
            if (!isNaN(date)) {
                document.getElementById('expiresAt').value = date.toISOString().slice(0, 16);
            }
        }

        // ✅ FORMA CORRECTA CON QUILL
        const content = notif.content || '';
        quill.setContents([]);
        quill.clipboard.dangerouslyPasteHTML(content);

        // Cambiar botón
        document.querySelector('#notificationForm button[type="submit"]').textContent = 'Actualizar Notificación';

        document.getElementById('notificationForm').scrollIntoView({ behavior: 'smooth' });

    } catch (error) {
        console.error(error);
        Swal.fire('Error', 'No se pudo cargar', 'error');
    }
}

// =============================
// DELETE
// =============================
async function deleteNotification(id) {
    const result = await Swal.fire({
        title: '¿Eliminar notificación?',
        text: 'Esta acción no se puede deshacer',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        confirmButtonText: 'Sí, eliminar',
        cancelButtonText: 'Cancelar'
    });

    if (!result.isConfirmed) return;

    try {
        const response = await fetch(`/api/notifications/admin/${id}`, {
            method: 'DELETE'
        });

        let data;
        try {
            data = await response.json();
        } catch {
            data = {};
        }

        if (!response.ok || !data.success) {
            throw new Error(data.error || 'No se pudo eliminar');
        }

        Swal.fire({
            icon: 'success',
            title: 'Eliminada',
            text: 'Notificación eliminada correctamente',
            timer: 1500,
            showConfirmButton: false
        });

        // 🔄 Recargar lista manteniendo la página actual
        loadNotificationsList(currentPage);

    } catch (error) {
        console.error('Error eliminando:', error);

        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: error.message || 'No se pudo eliminar la notificación'
        });
    }
}


// =============================
// UPDATE
// =============================
async function updateNotification(id) {
    const formData = getFormData();

    try {
        const response = await fetch(`/api/notifications/admin/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!data.success) {
            return Swal.fire('Error', data.error, 'error');
        }

        Swal.fire('Actualizada', 'Correctamente', 'success');

        resetForm();
        loadNotificationsList();

    } catch (error) {
        console.error(error);
        Swal.fire('Error', 'No se pudo actualizar', 'error');
    }
}


// =============================
// CREATE
// =============================
async function createNotification() {
    const formData = getFormData();

    try {
        const response = await fetch('/api/notifications/admin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (!data.success) {
            return Swal.fire('Error', data.error, 'error');
        }

        Swal.fire('Creada', 'Correctamente', 'success');

        resetForm();
        loadNotificationsList();

    } catch (error) {
        console.error(error);
        Swal.fire('Error', 'No se pudo crear', 'error');
    }
}


// =============================
// FORM DATA
// =============================
function getFormData() {
    let rawContent = quill.root.innerHTML;
    let cleanContent = cleanQuillHTML(rawContent);

    return {
        title: document.getElementById('title').value,
        type: document.getElementById('type').value,
        customIcon: document.getElementById('customIcon').value, // NUEVO CAMPO
        message: document.getElementById('message').value,
        content: cleanContent,
        link: document.getElementById('link').value,
        imageUrl: document.getElementById('imageUrl').value,
        expiresAt: document.getElementById('expiresAt').value || null,
        isActive: true
    };
}


// =============================
// RESET FORM
// =============================
function resetForm() {
    document.getElementById('notificationForm').reset();

    quill.setContents([]);

    editingId = null;

    document.querySelector('#notificationForm button[type="submit"]').textContent = 'Enviar Notificación';
}

// =============================
// LOAD LIST
// =============================
async function loadNotificationsList(page = 1) {
    currentPage = page;

    try {
        const response = await fetch(`/api/notifications/admin?page=${page}&limit=10`);
        const data = await response.json();

        if (data.success) {
            renderNotificationsList(data.notifications);
            renderPagination(data.pagination);
        } else {
            console.error('Error:', data.error);
        }

    } catch (error) {
        console.error('Error cargando notificaciones:', error);
    }
}


// =============================
// RENDER LIST
// =============================
function renderNotificationsList(notifications) {
    const container = document.getElementById('notificationsList');

    if (!notifications || notifications.length === 0) {
        container.innerHTML = `
            <div class="text-center py-8 text-gray-400">
                <i class="fas fa-bell-slash text-3xl mb-2"></i>
                <p>No hay notificaciones</p>
            </div>
        `;
        return;
    }

    container.innerHTML = notifications.map(notif => `
      <div class="border border-gray-200 rounded-xl overflow-hidden hover:shadow-md transition bg-white">
          ${notif.imageUrl ? `<img src="${escapeHtml(notif.imageUrl)}" class="w-full h-24 object-cover" />` : ''}
          <div class="p-4">
              <div class="flex justify-between items-start mb-2">
                  <div class="flex items-center gap-2">
                      <span class="text-xs font-medium px-2.5 py-1 rounded-full ${getStatusClass(notif.isActive)}">
                          <i class="${notif.customIcon || 'fas fa-circle'} mr-1"></i>
                          ${notif.isActive ? 'Activa' : 'Inactiva'}
                      </span>
                  </div>
                  <div class="flex gap-3">
                      <button onclick="editNotification('${notif._id}')" class="text-gray-400 hover:text-indigo-500 transition">
                          <i class="fas fa-edit"></i>
                      </button>
                      <button onclick="deleteNotification('${notif._id}')" class="text-gray-400 hover:text-red-500 transition">
                          <i class="fas fa-trash"></i>
                      </button>
                  </div>
              </div>
              <h3 class="font-bold text-gray-800 text-sm">${escapeHtml(notif.title)}</h3>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2">${escapeHtml(notif.message)}</p>
          </div>
      </div>
  `).join('');
}

function renderPagination(pagination) {
    const container = document.getElementById('pagination');

    if (!pagination || pagination.totalPages <= 1) {
        container.innerHTML = '';
        return;
    }

    let html = '';

    for (let i = 1; i <= pagination.totalPages; i++) {
        html += `
            <button onclick="loadNotificationsList(${i})"
                class="px-3 py-1 rounded-lg ${
                    i === currentPage
                        ? 'bg-indigo-600 text-white'
                        : 'bg-gray-200 text-gray-700 hover:bg-gray-300'
                }">
                ${i}
            </button>
        `;
    }

    container.innerHTML = html;
}


function getStatusClass(isActive) {
    return isActive
        ? 'bg-green-100 text-green-700'
        : 'bg-gray-100 text-gray-500';
}


function escapeHtml(text) {
    if (!text) return '';

    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// =============================
// CLEAN HTML
// =============================
function cleanQuillHTML(html) {
    if (!html) return '';

    let cleaned = html;

    const textarea = document.createElement('textarea');
    textarea.innerHTML = cleaned;
    cleaned = textarea.value;

    cleaned = cleaned.replace(/<p>\s*<\/p>/g, '');
    cleaned = cleaned.replace(/<p><br><\/p>/g, '');

    cleaned = cleaned.replace(/&lt;/g, '<');
    cleaned = cleaned.replace(/&gt;/g, '>');
    cleaned = cleaned.replace(/&amp;/g, '&');
    cleaned = cleaned.replace(/&quot;/g, '"');
    cleaned = cleaned.replace(/&#39;/g, "'");

    cleaned = cleaned.replace(/^<p>(.*)<\/p>$/s, '$1');

    return cleaned;
}
</script>
    <script src="/js/app.js"></script>
</body>
</html>