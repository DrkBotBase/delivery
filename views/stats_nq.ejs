<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estado de Nequi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-slow {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        .refresh-rotate {
            transition: transform 0.5s ease;
        }
        .refresh-rotate.loading {
            transform: rotate(360deg);
        }
    </style>
</head>
<body class="bg-gray-100 font-sans">

    <div class="max-w-4xl mx-auto p-6">
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
            <div class="bg-green-50 border-b border-green-200 p-6 text-center">
                <div class="inline-flex items-center gap-2 bg-green-100 px-4 py-2 rounded-full">
                    <div id="statusIndicator" class="w-3 h-3 bg-green-500 rounded-full animate-pulse"></div>
                    <span id="generalStatus" class="text-green-700 font-semibold">
                        Cargando...
                    </span>
                </div>
                <h1 class="text-2xl font-bold text-gray-800 mt-4">Estado del servicio Nequi</h1>
                <div class="flex items-center justify-center gap-3 mt-2">
                    <p class="text-gray-500 text-sm">
                        Última actualización: </br><span id="lastUpdate">--</span>
                    </p>
                    <!--<button 
                        id="refreshBtn"
                        class="text-blue-500 hover:text-blue-700 text-sm flex items-center gap-1 transition-colors"
                        title="Actualizar datos"
                    >
                        <svg id="refreshIcon" class="w-4 h-4 refresh-rotate" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        <span>Actualizar</span>
                    </button>-->
                </div>
                <div id="cacheInfo" class="text-xs text-gray-400 mt-1"></div>
                <div id="errorMessage" class="hidden text-red-500 text-sm mt-2"></div>
            </div>

            <div id="contentContainer" class="p-6 space-y-4">
                <div class="text-center py-8 text-gray-500">
                    Cargando información de servicios...
                </div>
            </div>

            <div class="bg-gray-50 px-6 py-3 text-center text-xs text-gray-400 border-t border-gray-200">
                status.nequi.com.co • Todos los derechos reservados.
            </div>
        </div>
    </div>

    <script>
        // Función para obtener el color según el estado
        function getStatusColor(statusClass) {
            const colors = {
                operational: 'green',
                degraded: 'yellow',
                partial: 'orange',
                outage: 'red',
                maintenance: 'blue',
                unknown: 'gray'
            };
            return colors[statusClass] || 'gray';
        }

        // Función para formatear fecha
        function formatDate(dateString) {
            if (!dateString) return '--';
            const date = new Date(dateString);
            return date.toLocaleString('es-CO');
        }

        // Función para renderizar los datos
        function renderStatus(data) {
            const container = document.getElementById('contentContainer');
            const generalStatusSpan = document.getElementById('generalStatus');
            const lastUpdateSpan = document.getElementById('lastUpdate');
            const statusIndicator = document.getElementById('statusIndicator');
            const errorDiv = document.getElementById('errorMessage');
            const cacheInfo = document.getElementById('cacheInfo');
            
            // Limpiar error
            errorDiv.classList.add('hidden');
            
            if (!data.success) {
                generalStatusSpan.textContent = 'Error al cargar datos';
                generalStatusSpan.classList.add('text-red-700');
                statusIndicator.classList.remove('bg-green-500');
                statusIndicator.classList.add('bg-red-500');
                errorDiv.textContent = data.error || 'Error al conectar con el servidor';
                errorDiv.classList.remove('hidden');
                container.innerHTML = `
                    <div class="text-center py-8 text-red-600 bg-red-50 rounded-xl">
                        ⚠️ No se pudieron cargar los datos del estado de Nequi
                    </div>
                `;
                return;
            }
            
            // Actualizar estado general
            const generalStatus = data.generalStatus === "All Systems Operational" ? "Todos los servicios están operativos" : data.generalStatus;
            generalStatusSpan.textContent = generalStatus;
            const isOperational = data.isAllOperational;
            generalStatusSpan.className = isOperational ? 'text-green-700 font-semibold' : 'text-yellow-700 font-semibold';
            statusIndicator.className = `w-3 h-3 rounded-full ${isOperational ? 'bg-green-500' : 'bg-yellow-500'} animate-pulse`;
            
            // Actualizar fecha
            lastUpdateSpan.textContent = formatDate(data.lastUpdate);
            
            // Mostrar info de caché
            /*if (data.fromCache) {
                cacheInfo.innerHTML = data.cacheExpired ? 
                    '⚠️ Mostrando datos en caché (con posible retraso)' : 
                    '📦 Datos en caché (actualización cada 10 minutos)';
                cacheInfo.className = data.cacheExpired ? 'text-yellow-600 text-xs mt-1' : 'text-gray-400 text-xs mt-1';
            } else {
                cacheInfo.innerHTML = '🔄 Datos actualizados desde la fuente oficial';
                cacheInfo.className = 'text-green-600 text-xs mt-1';
            }*/
            
            // Construir HTML
            let html = '';
            
            // Servicios individuales
            if (data.individualServices && data.individualServices.length > 0) {
                html += `
                    <div class="border border-gray-200 rounded-xl overflow-hidden">
                        <div class="p-4 bg-gray-50 border-b border-gray-200">
                            <span class="text-lg font-semibold text-gray-800">Servicios Individuales</span>
                        </div>
                        <div class="divide-y divide-gray-100">
                `;
                
                data.individualServices.forEach(service => {
                    const color = getStatusColor(service.statusClass);
                    const textColor = `text-${color}-600`;
                    const bgColor = `bg-${color}-500`;
                    
                    html += `
                        <div class="flex items-center justify-between p-3 pl-8">
                            <span class="text-sm text-gray-600">${escapeHtml(service.name)}</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs ${textColor}">
                                    ${escapeHtml(service.status)}
                                </span>
                                <div class="w-1.5 h-1.5 rounded-full ${bgColor}"></div>
                            </div>
                        </div>
                    `;
                });
                
                html += `
                        </div>
                    </div>
                `;
            }
            
            // Grupos
            if (data.groups && data.groups.length > 0) {
                data.groups.forEach(group => {
                    const color = getStatusColor(group.statusClass);
                    const textColor = `text-${color}-600`;
                    const bgColor = `bg-${color}-500`;
                    const borderColor = color === 'green' ? 'border-gray-200' : `border-${color}-200`;
                    
                    html += `
                        <div class="border ${borderColor} rounded-xl overflow-hidden">
                            <div class="flex items-center justify-between p-4 bg-gray-50 border-b border-gray-200">
                                <div class="flex items-center gap-2">
                                    <span class="text-lg font-semibold text-gray-800">${escapeHtml(group.name)}</span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium ${textColor}">
                                        ${escapeHtml(group.status)}
                                    </span>
                                    <div class="w-2 h-2 rounded-full ${bgColor}"></div>
                                </div>
                            </div>
                            <div class="divide-y divide-gray-100">
                    `;
                    
                    if (group.children && group.children.length > 0) {
                        group.children.forEach(child => {
                            const childColor = getStatusColor(child.statusClass);
                            const childTextColor = `text-${childColor}-600`;
                            const childBgColor = `bg-${childColor}-500`;
                            
                            html += `
                                <div class="flex items-center justify-between p-3 pl-8">
                                    <span class="text-sm text-gray-600">${escapeHtml(child.name)}</span>
                                    <div class="flex items-center gap-2">
                                        <span class="text-xs ${childTextColor}">
                                            ${escapeHtml(child.status)}
                                        </span>
                                        <div class="w-1.5 h-1.5 rounded-full ${childBgColor}"></div>
                                    </div>
                                </div>
                            `;
                        });
                    }
                    
                    html += `
                            </div>
                        </div>
                    `;
                });
            }
            
            // Mensaje si no hay datos
            if ((!data.groups || data.groups.length === 0) && (!data.individualServices || data.individualServices.length === 0)) {
                html = `
                    <div class="text-center py-8 text-yellow-600 bg-yellow-50 rounded-xl">
                        ⚠️ No se encontraron servicios para mostrar
                    </div>
                `;
            }
            
            container.innerHTML = html;
        }
        
        // Función auxiliar para escapar HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
        
        // Función para cargar datos via AJAX
        async function loadStatus(forceRefresh = false) {
            //const refreshBtn = document.getElementById('refreshBtn');
            //const refreshIcon = document.getElementById('refreshIcon');
            
            // Mostrar loading
            //refreshBtn.disabled = true;
            //refreshIcon.classList.add('loading');
            
            try {
                const url = forceRefresh ? '/nq/api/status?refresh=true' : '/nq/api/status';
                const response = await fetch(url);
                const data = await response.json();
                renderStatus(data);
            } catch (error) {
                console.error('Error cargando datos:', error);
                document.getElementById('contentContainer').innerHTML = `
                    <div class="text-center py-8 text-red-600 bg-red-50 rounded-xl">
                        ⚠️ Error de conexión: ${error.message}
                    </div>
                `;
            } finally {
                //refreshBtn.disabled = false;
                //refreshIcon.classList.remove('loading');
            }
        }
        
        // Cargar datos iniciales
        loadStatus();
        
        // Configurar botón de refresco manual
        /*document.getElementById('refreshBtn').addEventListener('click', () => {
            loadStatus(true);
        });*/
        
        // Actualizar automáticamente cada 10 minutos (600,000 ms)
        setInterval(() => {
            loadStatus();
        }, 600000);
    </script>

</body>
</html>