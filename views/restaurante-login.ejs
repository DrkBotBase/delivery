<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <title>Login Restaurante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col font-sans text-gray-800">

    <header class="bg-indigo-600 text-white p-4 shadow-md">
        <div class="max-w-2xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2 cursor-pointer" onclick="window.location.href='/'">
                <div class="w-8 h-8 bg-white text-indigo-600 rounded-lg flex items-center justify-center shadow-sm">
                    <i class="fas fa-motorcycle"></i>
                </div>
                <span class="font-bold tracking-wide">Delivery App</span>
            </div>
        </div>
    </header>

    <main class="flex-grow flex items-center justify-center p-4">
        <div class="max-w-md w-full bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
            
            <div class="p-8">
                <div class="text-center mb-8">
                    <div class="w-16 h-16 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl shadow-sm transform -rotate-3">
                        <i class="fas fa-store"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-2">Panel de Administración</h2>
                    <p class="text-sm text-gray-500">
                        Ingresa con el código de tu restaurante para revisar tu saldo y consumos.
                    </p>
                </div>

                <form id="loginForm" onsubmit="handleLogin(event)" class="space-y-5">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-2">
                            Código de Restaurante
                        </label>
                        <div class="relative">
                            <i class="fas fa-hashtag absolute left-4 top-3.5 text-gray-400"></i>
                            <input type="text" id="linkCode" required
                                class="w-full pl-10 pr-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none font-bold text-gray-800 transition"
                                placeholder="Ej: 8224-1640">
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-2">
                            Contraseña
                        </label>
                        <div class="relative">
                            <i class="fas fa-lock absolute left-4 top-3.5 text-gray-400"></i>
                            <input type="password" id="password" required
                                class="w-full pl-10 pr-10 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:outline-none font-bold text-gray-800 transition"
                                placeholder="••••••">
                            <button type="button" onclick="togglePassword()" class="absolute right-4 top-3.5 text-gray-400 hover:text-indigo-500 focus:outline-none">
                                <i class="fas fa-eye" id="eyeIcon"></i>
                            </button>
                        </div>
                        <p class="text-[10px] text-gray-400 mt-2 text-right">
                            *La clave genérica es 123456
                        </p>
                    </div>

                    <button type="submit" id="btnLogin"
                        class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-indigo-500/30 transition active:scale-95 flex justify-center items-center gap-2 mt-2">
                        <span>Ingresar al Panel</span> <i class="fas fa-arrow-right text-sm"></i>
                    </button>
                </form>
            </div>
        </div>
    </main>

    <script>
        function togglePassword() {
            const pwdInput = document.getElementById('password');
            const eyeIcon = document.getElementById('eyeIcon');
            
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.classList.remove('fa-eye');
                eyeIcon.classList.add('fa-eye-slash');
            } else {
                pwdInput.type = 'password';
                eyeIcon.classList.remove('fa-eye-slash');
                eyeIcon.classList.add('fa-eye');
            }
        }

        async function handleLogin(event) {
            event.preventDefault();

            const linkCode = document.getElementById('linkCode').value.trim();
            const password = document.getElementById('password').value.trim();
            const btn = document.getElementById('btnLogin');

            if (!linkCode || !password) {
                return Swal.fire('Error', 'Por favor llena todos los campos', 'warning');
            }

            const originalBtnContent = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin"></i> Verificando...';
            btn.disabled = true;

            try {
                const response = await fetch('/api/restaurante/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ linkCode, password })
                });

                const data = await response.json();

                if (data.success) {
                    window.location.href = '/restaurante/panel';
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Acceso Denegado',
                        text: data.error || 'Código o contraseña incorrectos.',
                        confirmButtonColor: '#4f46e5'
                    });
                }
            } catch (error) {
                console.error('Error de login:', error);
                Swal.fire('Error', 'Ocurrió un problema de conexión con el servidor.', 'error');
            } finally {
                btn.innerHTML = originalBtnContent;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
