<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            touch-action: none;
            -webkit-tap-highlight-color: transparent;
        }
        canvas {
            background-color: #ffffff;
            touch-action: none;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
        }
        @keyframes pulse-soft {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(0.98); }
        }
        .connection-badge {
            animation: pulse-soft 2s infinite ease-in-out;
        }
        canvas {
        background-color: #f8fafc; /* Gris muy tenue para contraste */
        box-shadow: inset 0 0 20px rgba(79, 70, 229, 0.05);
      }
      .game-container-border {
          border: 4px solid #e2e8f0; /* Borde físico visible */
          background: white;
      }
    </style>
</head>
<body class="bg-indigo-950 min-h-screen flex items-center justify-center p-4 overflow-hidden">
    
    <div class="max-w-md w-full glass-panel rounded-[2.5rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.3)] border border-white/20">
        
        <div class="bg-indigo-600 p-6 text-white text-center relative overflow-hidden">
            <div class="relative z-10">
                <h1 class="text-2xl font-black tracking-tighter uppercase italic">Delivery Rush</h1>
                <div id="statusBadge" class="connection-badge mt-2 inline-flex items-center gap-2 bg-indigo-500/30 px-3 py-1 rounded-full border border-indigo-400/30">
                    <span class="w-2 h-2 bg-amber-400 rounded-full"></span>
                    <span id="statusText" class="text-[10px] font-bold uppercase tracking-widest text-indigo-100">Modo Offline</span>
                </div>
            </div>
            <div class="absolute -right-10 -top-10 w-32 h-32 bg-white/10 rounded-full blur-3xl"></div>
        </div>

        <div class="flex justify-around bg-white py-5 border-b border-gray-100">
            <div class="text-center">
                <p class="text-[9px] uppercase font-bold text-gray-400 tracking-widest mb-1">Ganancias</p>
                <p id="scoreValue" class="text-3xl font-black text-indigo-600 leading-none">$0</p>
            </div>
            <div class="w-px h-10 bg-gray-100 my-auto"></div>
            <div class="text-center">
                <p class="text-[9px] uppercase font-bold text-gray-400 tracking-widest mb-1">Récord</p>
                <p id="highScoreValue" class="text-3xl font-black text-gray-800 leading-none">$0</p>
            </div>
        </div>

        <div class="p-4 relative bg-gray-50">
    <div class="relative rounded-[2rem] overflow-hidden game-container-border shadow-xl">
        <canvas id="gameCanvas" width="340" height="340" class="w-full h-auto"></canvas>
        
        <div id="gameOverlay" class="absolute inset-0 bg-indigo-900/95 flex flex-col items-center justify-center text-white p-6 text-center hidden z-20 backdrop-blur-md">
            <div class="bg-white/10 p-5 rounded-full mb-4">
                <i class="fas fa-motorcycle text-4xl text-indigo-300"></i>
            </div>
            <h2 class="text-2xl font-black mb-2 uppercase italic tracking-tighter">¡Entrega Fallida!</h2>
            <p class="text-indigo-200 text-xs mb-8">El GPS se ha desorientado...</p>
            <button id="restartBtn" class="bg-white text-indigo-600 px-10 py-4 rounded-2xl font-black uppercase tracking-tighter shadow-2xl active:scale-95 transition-all">
                Nueva Ruta
            </button>
        </div>
    </div>
</div>

        <div class="p-6 bg-white space-y-4">
            <div class="flex gap-2">
                <button id="retryBtn" class="flex-[2] bg-indigo-600 text-white font-black py-4 rounded-2xl active:scale-95 transition-all shadow-lg shadow-indigo-200 flex items-center justify-center gap-2">
                    <i class="fas fa-sync-alt"></i> REINTENTAR
                </button>
                <button id="homeBtn" class="flex-1 bg-gray-100 text-gray-600 font-bold py-4 rounded-2xl active:scale-95 transition-all flex items-center justify-center">
                    <i class="fas fa-home"></i>
                </button>
            </div>
            
            <p id="statusMsg" class="text-center text-[11px] font-medium text-gray-400 px-4">
                Usa las flechas o desliza sobre el mapa para conducir
            </p>
        </div>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreSpan = document.getElementById('scoreValue');
        const highScoreSpan = document.getElementById('highScoreValue');
        const overlay = document.getElementById('gameOverlay');
        const statusBadge = document.getElementById('statusBadge');
        const statusText = document.getElementById('statusText');
        const statusMsg = document.getElementById('statusMsg');
        
        // Configuración Juego
        const GRID_SIZE = 17;
        const CELL_SIZE = canvas.width / GRID_SIZE;
        const FOOD_MENU = [
            { icon: '🍔', points: 10 }, { icon: '🍕', points: 15 }, 
            { icon: '🍣', points: 25 }, { icon: '🥤', points: 5 }
        ];

        let snake = [{x: 8, y: 8}, {x: 7, y: 8}];
        let direction = 'RIGHT';
        let nextDirection = 'RIGHT';
        let food = null;
        let score = 0;
        let highScore = localStorage.getItem('delivery_highscore') || 0;
        let gameLoop = null;
        let isGameOver = false;

        highScoreSpan.innerText = `$${highScore}`;

        function updateStatus() {
            if (navigator.onLine) {
                statusBadge.querySelector('span').className = "w-2 h-2 bg-green-500 rounded-full";
                statusText.innerText = "Conexión Recuperada";
                statusMsg.innerText = "✅ ¡Ya puedes volver! Usa el botón Reintentar.";
                statusMsg.className = "text-center text-[11px] font-bold text-green-600";
            } else {
                statusBadge.querySelector('span').className = "w-2 h-2 bg-amber-400 rounded-full";
                statusText.innerText = "Modo Offline";
                statusMsg.innerText = "🎮 GPS sin señal. Diviértete mientras vuelve.";
                statusMsg.className = "text-center text-[11px] font-medium text-gray-400";
            }
        }

function drawGrid() {
        ctx.strokeStyle = '#f1f5f9'; // Líneas del grid un poco más oscuras
        ctx.lineWidth = 1;
        for (let i = 0; i <= GRID_SIZE; i++) {
            ctx.beginPath();
            ctx.moveTo(i * CELL_SIZE, 0); ctx.lineTo(i * CELL_SIZE, canvas.height); ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(0, i * CELL_SIZE); ctx.lineTo(canvas.width, i * CELL_SIZE); ctx.stroke();
        }
    }

function draw() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drawGrid();

        // 1. Dibujar Comida con sombra suave
        if (food) {
            ctx.shadowColor = "rgba(0,0,0,0.1)";
            ctx.shadowBlur = 5;
            ctx.font = `${CELL_SIZE * 0.7}px Arial`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(food.icon, food.x * CELL_SIZE + CELL_SIZE/2, food.y * CELL_SIZE + CELL_SIZE/2);
            ctx.shadowBlur = 0;
        }

        // 2. Dibujar Moto (Serpiente)
        snake.forEach((segment, index) => {
            const x = segment.x * CELL_SIZE;
            const y = segment.y * CELL_SIZE;
            
            if (index === 0) {
                // CABEZA CON DIRECCIÓN
                ctx.save();
                ctx.translate(x + CELL_SIZE / 2, y + CELL_SIZE / 2);
                
                // Rotación según dirección
                if (direction === 'UP') ctx.rotate(-Math.PI / 2);
                if (direction === 'DOWN') ctx.rotate(Math.PI / 2);
                if (direction === 'LEFT') ctx.rotate(Math.PI);
                // RIGHT es 0 grados
                
                // Cuerpo de la moto (Cabeza)
                ctx.fillStyle = '#4f46e5';
                ctx.beginPath();
                ctx.roundRect(-CELL_SIZE/2 + 2, -CELL_SIZE/2 + 2, CELL_SIZE - 4, CELL_SIZE - 4, [10, 4, 4, 10]);
                ctx.fill();

                // Casco del repartidor
                ctx.fillStyle = '#1e1b4b';
                ctx.beginPath();
                ctx.arc(-2, 0, 6, 0, Math.PI * 2);
                ctx.fill();

                // Luces delanteras (Indican hacia dónde va)
                ctx.fillStyle = '#fbbf24';
                ctx.fillRect(CELL_SIZE/2 - 6, -CELL_SIZE/2 + 6, 3, 4);
                ctx.fillRect(CELL_SIZE/2 - 6, CELL_SIZE/2 - 10, 3, 4);
                
                ctx.restore();
            } else {
                // CUERPO (Cajas de entrega)
                ctx.fillStyle = '#c7d2fe';
                const pad = 6;
                ctx.beginPath();
                ctx.roundRect(x + pad, y + pad, CELL_SIZE - pad*2, CELL_SIZE - pad*2, 4);
                ctx.fill();
                
                // Detalle de "caja"
                ctx.strokeStyle = '#a5b4fc';
                ctx.strokeRect(x + pad + 2, y + pad + 2, CELL_SIZE - pad*2 - 4, CELL_SIZE - pad*2 - 4);
            }
        });
    }

        function update() {
            direction = nextDirection;
            const head = { ...snake[0] };
            if (direction === 'UP') head.y--;
            if (direction === 'DOWN') head.y++;
            if (direction === 'LEFT') head.x--;
            if (direction === 'RIGHT') head.x++;

            if (head.x < 0 || head.x >= GRID_SIZE || head.y < 0 || head.y >= GRID_SIZE || 
                snake.some(s => s.x === head.x && s.y === head.y)) {
                isGameOver = true;
                clearInterval(gameLoop);
                overlay.classList.remove('hidden');
                return;
            }

            snake.unshift(head);
            if (head.x === food.x && head.y === food.y) {
                score += food.points;
                scoreSpan.innerText = `$${score}`;
                if (score > highScore) {
                    highScore = score;
                    highScoreSpan.innerText = `$${highScore}`;
                    localStorage.setItem('delivery_highscore', highScore);
                }
                spawnFood();
            } else {
                snake.pop();
            }
            draw();
        }

function spawnFood() {
    let newX, newY;
    let isOverlapping;

    // Intentar generar coordenadas hasta encontrar una que no esté ocupada
    do {
        isOverlapping = false;
        newX = Math.floor(Math.random() * GRID_SIZE);
        newY = Math.floor(Math.random() * GRID_SIZE);

        // Verificar si la nueva posición coincide con algún segmento de la moto
        for (let segment of snake) {
            if (segment.x === newX && segment.y === newY) {
                isOverlapping = true;
                break;
            }
        }
    } while (isOverlapping);

    // Una vez encontrada la posición libre, asignamos la comida
    food = {
        x: newX,
        y: newY,
        ...FOOD_MENU[Math.floor(Math.random() * FOOD_MENU.length)]
    };
}


        function resetGame() {
            snake = [{x: 8, y: 8}, {x: 7, y: 8}];
            direction = 'RIGHT';
            nextDirection = 'RIGHT';
            score = 0;
            scoreSpan.innerText = "$0";
            isGameOver = false;
            overlay.classList.add('hidden');
            spawnFood();
            if (gameLoop) clearInterval(gameLoop);
            gameLoop = setInterval(update, 150);
        }

        // Swipe Controls
        let touchX = 0, touchY = 0;
        canvas.addEventListener('touchstart', e => {
            touchX = e.touches[0].clientX;
            touchY = e.touches[0].clientY;
        });

        canvas.addEventListener('touchmove', e => {
            if (isGameOver) return;
            const dx = e.touches[0].clientX - touchX;
            const dy = e.touches[0].clientY - touchY;
            if (Math.abs(dx) > 20 || Math.abs(dy) > 20) {
                if (Math.abs(dx) > Math.abs(dy)) {
                    if (dx > 0 && direction !== 'LEFT') nextDirection = 'RIGHT';
                    else if (dx < 0 && direction !== 'RIGHT') nextDirection = 'LEFT';
                } else {
                    if (dy > 0 && direction !== 'UP') nextDirection = 'DOWN';
                    else if (dy < 0 && direction !== 'DOWN') nextDirection = 'UP';
                }
                touchX = e.touches[0].clientX;
                touchY = e.touches[0].clientY;
            }
            e.preventDefault();
        }, { passive: false });

        document.getElementById('retryBtn').onclick = () => {
            if (navigator.onLine) window.location.reload();
            else {
                statusMsg.innerText = "❌ Sigo sin señal...";
                setTimeout(updateStatus, 2000);
            }
        };

        document.getElementById('homeBtn').onclick = () => {
            if (navigator.onLine) window.location.href = '/panel';
        };

        document.getElementById('restartBtn').onclick = resetGame;
        window.addEventListener('online', updateStatus);
        window.addEventListener('offline', updateStatus);

        updateStatus();
        resetGame();
    </script>
</body>
</html>
