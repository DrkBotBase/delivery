<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="referrer" content="no-referrer-when-downgrade">
    <title>Panel de Restaurante</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-50 text-gray-800 font-sans h-screen flex flex-col">

    <header class="bg-indigo-600 text-white p-4 shadow-md flex justify-between items-center">
        <div class="flex items-center gap-2">
            <i class="fas fa-store text-xl"></i>
            <h1 class="text-lg font-bold"><%= restaurant.name %></h1>
        </div>
        <button onclick="window.location.href='/auth/logout'" class="text-indigo-200 hover:text-white text-sm">
            Cerrar Sesión
        </button>
    </header>

    <main class="flex-grow p-6 max-w-4xl mx-auto w-full">
        <div class="grid md:grid-cols-2 gap-6 mt-6">
            
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-200 text-center relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-emerald-400 to-green-500"></div>
                <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-2">Escaneos Disponibles</h2>
                <p class="text-6xl font-black text-emerald-600 mb-2"><%= restaurant.availableScans %></p>
                <p class="text-sm text-gray-500 mb-6">En tu bolsa prepago</p>
                
                <button onclick="alert('Pronto conectaremos MercadoPago/Wompi para recargar facturas.')" class="w-full bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl shadow-lg transition">
                    <i class="fas fa-plus-circle"></i> Recargar Bolsa
                </button>
            </div>

            <div class="space-y-6">
                <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-200 flex items-center justify-between">
                    <div>
                        <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider">Total Histórico</h2>
                        <p class="text-2xl font-bold text-gray-800"><%= restaurant.totalScans %> facturas</p>
                    </div>
                    <div class="w-12 h-12 bg-indigo-50 text-indigo-500 rounded-full flex items-center justify-center text-xl">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-200">
                    <h2 class="text-sm font-bold text-gray-400 uppercase tracking-wider mb-4">Seguridad</h2>
                    <p class="text-sm text-gray-600 mb-4">Tu contraseña actual es genérica. Por seguridad, te recomendamos cambiarla.</p>
                    <button onclick="changePassword()" class="text-indigo-600 font-bold text-sm hover:underline">
                        <i class="fas fa-lock"></i> Cambiar Contraseña
                    </button>
                </div>
            </div>

        </div>
    </main>
    
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function changePassword() {
            Swal.fire({
                title: 'No disponible',
                text: 'La función para cambiar contraseña estará disponible en la próxima actualización.',
                icon: 'info'
            });
        }
    </script>
</body>
</html>