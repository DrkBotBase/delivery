<!DOCTYPE html>
<html lang="es">
<head>
  <%- include("partials/head") %>
</head>
<body class="bg-gray-50 min-h-screen pb-32 font-sans text-gray-800">
    <header class="bg-indigo-600 text-white shadow-lg sticky top-0 z-40">
        <div class="max-w-md mx-auto px-4 py-3 flex items-center gap-4">
            <a href="/panel" class="p-2 bg-white/20 rounded-full hover:bg-white/30 transition">
                <i class="fas fa-arrow-left"></i>
            </a>
            <div>
                <h1 class="text-lg font-bold leading-tight">Ruta de Entrega</h1>
                <p class="text-xs text-indigo-200" id="routeStats">Cargando datos...</p>
            </div>
            <button onclick="startRoute()" class="ml-auto p-2 text-indigo-100 hover:text-white">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>
    </header>

    <main class="max-w-md mx-auto px-4 py-6 space-y-6">
        <div class="grid grid-cols-2 gap-3">
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center">
                <p class="text-xs text-gray-500 uppercase font-bold mb-1">Ganancia Est.</p>
                <p class="text-2xl font-black text-emerald-600" id="totalEarnings">$0.00</p>
            </div>
            <div class="bg-white p-4 rounded-2xl shadow-sm border border-gray-100 flex flex-col items-center">
                <p class="text-xs text-gray-500 uppercase font-bold mb-1">Tiempo Est.</p>
                <p class="text-2xl font-black text-gray-700" id="totalTime">0 min</p>
            </div>
        </div>

        <div>
            <div class="flex justify-between items-end mb-4 px-1 border-b border-gray-200 pb-2">
                <h2 class="text-lg font-bold text-gray-800">Próximas Paradas</h2>
                <button onclick="exportRoute()" class="text-xs font-bold text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-full hover:bg-indigo-100 transition">
                    <i class="fas fa-file-export mr-1"></i> Exportar
                </button>
            </div>
            
            <div id="deliveriesList" class="space-y-4">
                <div class="text-center py-10 text-gray-400">
                    <i class="fas fa-spinner fa-spin text-3xl mb-3"></i>
                    <p>Cargando ruta...</p>
                </div>
            </div>
        </div>
    </main>

    <div class="fixed bottom-0 left-0 w-full bg-white border-t border-gray-200 shadow-[0_-10px_20px_rgba(0,0,0,0.05)] z-50 px-4 py-4 pb-6">
        <div class="max-w-md mx-auto grid grid-cols-4 gap-3">
            <button onclick="startNavigation()" id="navBtn" disabled 
                class="col-span-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl py-3.5 font-bold shadow-lg shadow-indigo-500/30 active:scale-95 transition flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-location-arrow"></i> <span>Navegar</span>
            </button>
            <button onclick="completeDelivery()" id="completeBtn" disabled
                class="col-span-1 bg-emerald-500 hover:bg-emerald-600 text-white rounded-xl py-3.5 font-bold shadow-lg shadow-emerald-500/30 active:scale-95 transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-check text-xl"></i>
            </button>
            <button onclick="skipDelivery()" id="skipBtn" disabled
                class="col-span-1 bg-gray-100 text-gray-600 hover:bg-gray-200 rounded-xl py-3.5 font-bold active:scale-95 transition flex items-center justify-center disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-forward text-xl"></i>
            </button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/route.js"></script>
</body>
</html>