    <section class="py-20 md:py-24 px-6 max-w-6xl mx-auto">
        <div class="grid md:grid-cols-3 gap-6 md:gap-8">
            <div class="group hero-pattern p-6 md:p-8 rounded-3xl shadow-sm border border-purple-100 hover:shadow-xl hover:-translate-y-1 transition duration-300">
