<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        @media (max-width: 640px) {
            .stats-grid {
                grid-template-columns: repeat(1, 1fr) !important;
            }
        }
        .animate-pulse-slow {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
        .premium-shadow {
            box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.05);
        }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    <header class="bg-indigo-600 text-white sticky top-0 z-50 shadow-lg">
        <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
            <div class="flex items-center gap-3 min-w-0">
                <div class="bg-white/20 p-2 rounded-lg">
                    <i class="fas fa-store text-lg"></i>
                </div>
                <div class="min-w-0">
                    <h1 class="text-sm font-bold truncate leading-none"><%= restaurant.name %></h1>
                    <p class="text-[10px] text-indigo-200 mt-1 uppercase tracking-wider font-semibold">ID: <%= restaurant.pointId %></p>
                </div>
            </div>
            <div class="flex items-center gap-1">
                <button onclick="changePassword()" class="p-2 hover:bg-white/10 rounded-full transition" title="Contraseña">
                    <i class="fas fa-key text-sm"></i>
                </button>
                <button onclick="window.location.href='/restaurante/logout'" class="p-2 hover:bg-red-500 rounded-full transition" title="Salir">
                    <i class="fas fa-sign-out-alt text-sm"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="p-4 pb-24 max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="bg-indigo-600 rounded-[2rem] p-6 text-white shadow-xl shadow-indigo-100 relative overflow-hidden group">
                <div class="relative z-10">
                    <div class="flex justify-between items-start">
                        <div>
                            <p class="text-indigo-100 text-xs font-bold uppercase tracking-widest">Escaneos Disponibles</p>
                            <p class="text-5xl font-black mt-2 leading-none"><%= restaurant.availableScans %></p>
                        </div>
                        <i class="fas fa-boxes text-3xl text-indigo-400/50 animate-pulse"></i>
                    </div>
                    <button data-nombre="<%= restaurant.name %>" class="mt-6 w-full bg-white text-indigo-600 hover:bg-indigo-50 rounded-2xl py-3.5 text-sm font-black transition-all transform active:scale-95 flex items-center justify-center gap-2 btn-recargar">
                        <i class="fas fa-plus-circle"></i> SOLICITAR RECARGA
                    </button>
                </div>
                <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-white/10 rounded-full blur-2xl"></div>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-1 gap-4">
                <div class="bg-white rounded-3xl p-5 shadow-sm border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-500">
                            <i class="fas fa-chart-bar"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-400 font-bold uppercase tracking-tighter">Total Facturas</p>
                            <p class="text-xl font-black text-gray-800"><%= restaurant.totalScans %></p>
                        </div>
                    </div>
                </div>
                <div class="bg-white rounded-3xl p-5 shadow-sm border border-gray-100">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-500">
                            <i class="fas fa-motorcycle"></i>
                        </div>
                        <div>
                            <p class="text-[10px] text-gray-400 font-bold uppercase tracking-tighter">Domiciliarios</p>
                            <p class="text-xl font-black text-gray-800"><%= stats.totalDeliveries %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <section class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden mb-8">
            <div class="p-5 border-b border-gray-50 bg-gray-50/50">
                <div class="flex flex-col gap-4">
                    <div class="flex justify-between items-center">
                        <h2 class="font-black text-gray-800 text-lg flex items-center gap-2">
                            <i class="fas fa-users text-indigo-500"></i> Mi Equipo
                        </h2>
                        <span class="text-[10px] font-bold bg-indigo-100 text-indigo-700 px-2 py-1 rounded-lg uppercase">Ranking</span>
                    </div>
                    
                    <div class="flex gap-2">
                        <div class="relative flex-1">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-300 text-xs"></i>
                            <input type="text" id="searchInput" placeholder="Buscar por nombre..." class="w-full pl-9 pr-4 py-2.5 bg-white border border-gray-100 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 outline-none">
                        </div>
                        <select id="sortSelect" onchange="sortDeliveries(this.value)" class="bg-white border border-gray-100 text-xs font-bold py-2.5 px-3 rounded-xl outline-none">
                            <option value="orders_desc">🔥 Top</option>
                            <option value="money_desc">💰 $</option>
                        </select>
                    </div>
                </div>
            </div>
        
            <div id="deliveryCardsContainer" class="divide-y divide-gray-50">
                <% if (deliveryUsers.length === 0) { %>
                    <div class="p-12 text-center text-gray-400 italic text-sm">No hay domiciliarios vinculados aún.</div>
                <% } else { %>
                    <% deliveryUsers.forEach(user => { %>
                        <div id="user-card-<%= user.id %>" class="delivery-card-item p-3 hover:bg-gray-50 active:bg-gray-100 transition-all cursor-pointer" 
                             data-orders="<%= user.stats.totalDeliveries %>" 
                             data-earned="<%= user.stats.totalEarned %>"
                             data-name="<%= (user.fullName || user.username).toLowerCase() %>"
                             onclick="showDeliveryStats('<%= user.id %>', '<%= user.fullName || user.username %>')">
                            
                            <div class="flex items-center gap-3">
                                <div class="relative shrink-0">
                                    <img src="<%= user.avatar && user.avatar.startsWith('http') ? user.avatar : '/avatars/' + (user.avatar || 'default.svg') %>" 
                                         class="w-12 h-12 rounded-xl object-cover shadow-md" 
                                         onerror="this.src='/avatars/default.svg'">
                                    <div class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-green-500 border-2 border-white rounded-full shadow-sm"></div>
                                </div>
                                
                                <div class="flex-1 min-w-0">
                                    <p class="font-black text-gray-800 text-xs truncate uppercase tracking-tight"><%= (user.fullName || user.username).substring(0, 20) %></p>
                                    <p class="text-[9px] text-gray-400 font-mono truncate">@<%= user.username %></p>
                                </div>
                                
                                <div class="flex items-center gap-2 bg-gray-50 px-2 py-1.5 rounded-xl w-[125px] justify-center shrink-0">
                                    <div class="text-center">
                                        <p class="text-sm font-black text-indigo-600"><%= user.stats.totalDeliveries %></p>
                                        <p class="text-[7px] text-gray-400 uppercase font-bold">Pedidos</p>
                                    </div>
                                    <div class="w-px h-5 bg-gray-300"></div>
                                    <div class="text-center">
                                        <p class="text-sm font-black text-emerald-600 whitespace-nowrap">
                                            $<%= (() => {
                                                const earned = user.stats.totalEarned;
                                                if (earned >= 1_000_000) {
                                                    let millions = earned / 1_000_000;
                                                    let formatted = millions % 1 === 0 ? millions : millions.toFixed(2).replace(/\.?0+$/, '');
                                                    return formatted + 'm';
                                                } else if (earned >= 1_000) {
                                                    return Math.floor(earned / 1_000) + 'k';
                                                } else {
                                                    return earned;
                                                }
                                            })() %>
                                        </p>
                                        <p class="text-[7px] text-gray-400 uppercase font-bold">Ganado</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
        </section>
        
        <section class="bg-white rounded-[2rem] shadow-sm border border-gray-100 overflow-hidden">
            <div class="p-5 flex justify-between items-center border-b border-gray-50">
                <h2 class="font-black text-gray-800 text-base">Recargas Recientes</h2>
                <button onclick="viewAllRecharges()" class="text-indigo-600 text-xs font-bold uppercase tracking-wider">Ver Todo</button>
            </div>
            
            <div class="divide-y divide-gray-50">
                <% if (recharges.length === 0) { %>
                    <div class="p-8 text-center text-gray-400 text-sm italic">Sin recargas aún.</div>
                <% } else { %>
                    <% recharges.slice(0, 3).forEach(function(recharge) { %>
                        <div class="p-4 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center">
                                    <i class="fas fa-plus text-xs"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-black text-gray-800">+<%= recharge.amount %> Escaneos</p>
                                    <p class="text-[10px] text-gray-400"><%= new Date(recharge.createdAt).toLocaleDateString() %></p>
                                </div>
                            </div>
                            <div class="text-right">
                                <p class="text-xs font-bold text-gray-500"><%= recharge.newScans %></p>
                                <p class="text-[8px] text-gray-300 uppercase font-bold tracking-widest">Balance</p>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </section>
    </main>

    <div class="fixed bottom-6 right-6 z-40">
        <button onclick="showHelp()" class="bg-indigo-600 text-white rounded-full w-12 h-12 shadow-lg flex items-center justify-center hover:bg-indigo-700 transition">
            <i class="fas fa-lightbulb text-xl"></i>
        </button>
    </div>

<script>
    function formatDateOnly(dateStr) {
        if (!dateStr) return 'Sin fecha';
        let date;
        
        if (!dateStr.includes('T')) {
            date = new Date(dateStr.replace(/-/g, '\/')); 
        } else {
            date = new Date(dateStr);
        }
        if (isNaN(date.getTime())) return 'Fecha inválida';
    
        const formatter = new Intl.DateTimeFormat('es-CO', {
            weekday: 'short',
            day: 'numeric',
            month: 'short'
        });
    
        let formatted = formatter.format(date);
        return formatted.charAt(0).toUpperCase() + formatted.slice(1);
    }
    
    function sortDeliveries(criteria) {
        const container = document.getElementById('deliveryCardsContainer');
        if (!container) return;

        const cards = Array.from(container.getElementsByClassName('delivery-card-item'));

        cards.sort((a, b) => {
            const ordersA = parseInt(a.getAttribute('data-orders')) || 0;
            const ordersB = parseInt(b.getAttribute('data-orders')) || 0;
            const earnedA = parseInt(a.getAttribute('data-earned')) || 0;
            const earnedB = parseInt(b.getAttribute('data-earned')) || 0;

            switch(criteria) {
                case 'orders_desc':
                    return ordersB - ordersA;
                case 'orders_asc':
                    return ordersA - ordersB;
                case 'money_desc':
                    return earnedB - earnedA;
                case 'money_asc':
                    return earnedA - earnedB;
                default:
                    return 0;
            }
        });
        
        cards.forEach(card => {
            container.appendChild(card);
        });
    }

    function searchDeliveries() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
        const cards = document.querySelectorAll('.delivery-card-item');
        
        cards.forEach(card => {
            const name = card.getAttribute('data-name') || '';
            if (searchTerm === '' || name.includes(searchTerm)) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }
    
    async function viewAllRecharges() {
        try {
            const res = await fetch('/restaurante/recharges');
            const data = await res.json();
            
            if (data.success && data.recharges.length > 0) {
                let rechargesHtml = '<div class="space-y-3 max-h-96 overflow-y-auto">';
                
                data.recharges.forEach(recharge => {
                    rechargesHtml += `
                        <div class="p-3 bg-gray-50 rounded-xl">
                            <div class="flex justify-between items-start">
                                <div>
                                    <p class="font-semibold text-gray-800 text-sm">+${recharge.amount} escaneos</p>
                                    <p class="text-xs text-gray-500 mt-1">
                                        <i class="fas fa-user-shield"></i> ${recharge.adminName}
                                    </p>
                                </div>
                                <div class="text-right">
                                    <p class="text-xs text-gray-500">${new Date(recharge.createdAt).toLocaleDateString()}</p>
                                    <p class="text-xs text-gray-400">${new Date(recharge.createdAt).toLocaleTimeString()}</p>
                                </div>
                            </div>
                            <!--
                            <div class="flex justify-between items-center mt-2 text-xs">
                                <span class="text-gray-500">Antes: ${recharge.previousScans}</span>
                                <i class="fas fa-arrow-right text-gray-400 text-xs"></i>
                                <span class="text-emerald-600 font-semibold">Ahora: ${recharge.newScans}</span>
                            </div>
                            -->
                            ${recharge.notes ? `<p class="text-xs text-gray-400 mt-2"><i class="fas fa-sticky-note"></i> ${recharge.notes}</p>` : ''}
                        </div>
                    `;
                });
                
                rechargesHtml += '</div>';
                
                Swal.fire({
                    title: 'Historial de Recargas',
                    html: rechargesHtml,
                    confirmButtonColor: '#4f46e5',
                    confirmButtonText: 'Cerrar',
                    width: window.innerWidth < 640 ? '95%' : '500px',
                    customClass: { popup: 'rounded-2xl' }
                });
            } else {
                Swal.fire('Info', 'No hay recargas registradas', 'info');
            }
        } catch (error) {
            console.error(error);
            Swal.fire('Error', 'No se pudo cargar el historial', 'error');
        }
    }
    
    async function loadAllDeliveryStats() {
        const users = <%- JSON.stringify(deliveryUsers.map(u => ({ 
            id: u.id, 
            name: u.fullName || u.username 
        }))) %>;
        
        if (!users || users.length === 0) return;
        
        const fetchPromises = users.map(async (user) => {
            try {
                const res = await fetch(`/restaurante/delivery-stats/${user.id}`);
                const data = await res.json();
                
                if (data.success) {
                    const ordersSpan = document.querySelector(`.stats-orders-${user.id}`);
                    const earnedSpan = document.querySelector(`.stats-earned-${user.id}`);
                    const placeholder = document.querySelector(`.stats-placeholder-${user.id}`);
                    const loaded = document.querySelector(`.stats-loaded-${user.id}`);
                    const cardElement = document.getElementById(`user-card-${user.id}`);
                    
                    if (ordersSpan && earnedSpan) {
                        ordersSpan.textContent = data.stats.totalOrders;
                        earnedSpan.textContent = data.stats.totalEarned.toLocaleString();
                        
                        if (placeholder && loaded) {
                            placeholder.classList.add('hidden');
                            loaded.classList.remove('hidden');
                        }
                    }
                    
                    if (cardElement) {
                        cardElement.setAttribute('data-orders', data.stats.totalOrders);
                        cardElement.setAttribute('data-earned', data.stats.totalEarned);
                    }
                }
            } catch (error) {
                console.error(`Error cargando stats para ${user.id}:`, error);
            }
        });

        await Promise.all(fetchPromises);
        
        const sortSelect = document.getElementById('sortSelect');
        if (sortSelect) {
            sortSelect.value = 'orders_desc';
            sortDeliveries('orders_desc');
        }
    }
    
    async function showDeliveryStats(userId, userName) {
        let currentPeriod = 'week';
        let currentData = null;
        
        async function loadStats(period) {
            const res = await fetch(`/restaurante/delivery-stats/${userId}?period=${period}`);
            return await res.json();
        }
        
        const renderContent = () => {
            const isWeek = currentPeriod === 'week';
            const stats = currentData.stats || {};
            const history = currentData.history || [];
            const monthlySummary = currentData.monthlySummary || [];
            const bestShift = currentData.bestShift;
            const worstShift = currentData.worstShift;
            console.log(currentData)
            return `
                <div class="space-y-4 text-left">
                    <div class="flex gap-2 bg-gray-100 rounded-lg p-1">
                        <button onclick="window.switchPeriod('week')" 
                            class="flex-1 py-2 px-3 rounded-lg text-sm font-medium transition ${currentPeriod === 'week' ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-200'}">
                            <i class="fas fa-calendar-week"></i> 7 Días
                        </button>
                        <button onclick="window.switchPeriod('all')" 
                            class="flex-1 py-2 px-3 rounded-lg text-sm font-medium transition ${currentPeriod === 'all' ? 'bg-indigo-600 text-white' : 'text-gray-600 hover:bg-gray-200'}">
                            <i class="fas fa-history"></i> Historial completo
                        </button>
                    </div>
                    
                    <div class="grid grid-cols-2 gap-3">
                        <div class="bg-indigo-50 rounded-xl p-3 text-center">
                            <p class="text-2xl font-bold text-indigo-600">${stats.totalShifts || 0}</p>
                            <p class="text-xs text-gray-500">Jornadas</p>
                        </div>
                        <div class="bg-emerald-50 rounded-xl p-3 text-center">
                            <p class="text-2xl font-bold text-emerald-600">$${(stats.totalEarned || 0).toLocaleString()}</p>
                            <p class="text-xs text-gray-500">Total ganado</p>
                        </div>
                    </div>
                    
                    <div class="bg-green-50 rounded-xl p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <i class="fas fa-trophy text-green-600"></i>
                            <p class="text-xs font-semibold text-green-600 uppercase tracking-wide">Mejor jornada</p>
                        </div>
                        ${bestShift ? `
                            <p class="text-sm font-bold text-gray-800">${formatDateOnly(bestShift.date)}</p>
                            <div class="flex justify-between items-center mt-2">
                                <span class="text-xs text-gray-500">Pedidos</span>
                                <span class="text-sm font-semibold text-gray-700">${bestShift.deliveriesCount || 0}</span>
                            </div>
                            <div class="flex justify-between items-center mt-1">
                                <span class="text-xs text-gray-500">Ganado</span>
                                <span class="text-sm font-bold text-green-600">$${(bestShift.amount || 0).toLocaleString()}</span>
                            </div>
                        ` : '<p class="text-sm text-gray-400 text-center py-4">Sin jornadas cerradas</p>'}
                    </div>
                    
                    <div class="bg-red-50 rounded-xl p-3">
                        <div class="flex items-center gap-2 mb-2">
                            <i class="fas fa-chart-line text-red-600"></i>
                            <p class="text-xs font-semibold text-red-600 uppercase tracking-wide">Peor jornada</p>
                        </div>
                        ${worstShift ? `
                            <p class="text-sm font-bold text-gray-800">${formatDateOnly(worstShift.date)}</p>
                            <div class="flex justify-between items-center mt-2">
                                <span class="text-xs text-gray-500">Pedidos</span>
                                <span class="text-sm font-semibold text-gray-700">${worstShift.deliveriesCount || 0}</span>
                            </div>
                            <div class="flex justify-between items-center mt-1">
                                <span class="text-xs text-gray-500">Ganado</span>
                                <span class="text-sm font-bold text-red-600">$${(worstShift.amount || 0).toLocaleString()}</span>
                            </div>
                        ` : '<p class="text-sm text-gray-400 text-center py-4">Sin jornadas cerradas</p>'}
                    </div>
                    
                    ${isWeek ? `
                        <div>
                            <p class="text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-calendar-week text-indigo-500"></i> Últimas jornadas
                            </p>
                            ${history.length > 0 ? `
                                <div class="space-y-2 max-h-60 overflow-y-auto">
                                    ${history.map(day => `
                                        <div class="bg-gray-50 rounded-xl p-3">
                                            <div class="flex justify-between items-center">
                                                <span class="font-semibold text-gray-700">${formatDateOnly(day._id)}</span>
                                                <span class="text-xs bg-white px-2 py-0.5 rounded-full text-gray-500">${day.dailyCount} jornada(s)</span>
                                            </div>
                                            <div class="flex justify-between items-center mt-2 text-sm">
                                                <span class="text-gray-500">Pedidos</span>
                                                <span class="font-medium text-gray-700">${day.dailyDeliveries || 0}</span>
                                            </div>
                                            <div class="flex justify-between items-center mt-1">
                                                <span class="text-gray-500">Total</span>
                                                <span class="font-bold text-emerald-600">$${(day.dailyTotal || 0).toLocaleString()}</span>
                                            </div>
                                        </div>
                                    `).join('')}
                                </div>
                            ` : '<p class="text-center text-gray-400 text-sm py-4">Sin jornadas en los últimos 7 días</p>'}
                        </div>
                    ` : `
                        <div>
                            <p class="text-sm font-semibold text-gray-700 mb-2">
                                <i class="fas fa-chart-line text-indigo-500"></i> Resumen por mes
                            </p>
                            ${monthlySummary.length > 0 ? `
                                <div class="space-y-2 max-h-60 overflow-y-auto">
                                    ${monthlySummary.map(month => {
                                        const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                                        const monthName = monthNames[(month._id.month || 1) - 1];
                                        return `
                                            <div class="bg-gray-50 rounded-xl p-3">
                                                <div class="flex justify-between items-center mb-2">
                                                    <span class="font-semibold text-gray-700">${monthName} ${month._id.year || 2024}</span>
                                                    <span class="text-xs bg-white px-2 py-0.5 rounded-full text-gray-500">${month.monthShifts || 0} jornadas</span>
                                                </div>
                                                <div class="flex justify-between items-center text-sm">
                                                    <span class="text-gray-500">Pedidos</span>
                                                    <span class="font-medium text-gray-700">${month.monthDeliveries || 0}</span>
                                                </div>
                                                <div class="flex justify-between items-center mt-1">
                                                    <span class="text-gray-500">Total</span>
                                                    <span class="font-bold text-emerald-600">$${(month.monthTotal || 0).toLocaleString()}</span>
                                                </div>
                                            </div>
                                        `;
                                    }).join('')}
                                </div>
                            ` : '<p class="text-center text-gray-400 text-sm py-4">Sin registros históricos</p>'}
                        </div>
                    `}
                    
                    <div class="text-xs text-gray-400 text-center pt-2 border-t">
                        Desde: ${currentData.user && currentData.user.joinedAt ? new Date(currentData.user.joinedAt).toLocaleDateString() : 'No disponible'}
                    </div>
                </div>
            `;
        };
        
        Swal.fire({
          title: userName,
          width: window.innerWidth < 640 ? '95%' : '450px',
          customClass: { popup: 'rounded-2xl' },
          html: '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-3xl text-indigo-500"></i><p class="mt-3 text-gray-500">Cargando estadísticas...</p></div>',
          showConfirmButton: false,
          allowOutsideClick: false,
          didOpen: async () => {
              try {
                  currentData = await loadStats(currentPeriod);
                  if (currentData.success) {
                      Swal.update({
                          html: renderContent(),
                          showConfirmButton: true,
                          confirmButtonColor: '#4f46e5',
                          confirmButtonText: 'Cerrar'
                      });
                  } else {
                      Swal.fire('Error', 'No se pudieron cargar las estadísticas', 'error');
                  }
              } catch (error) {
                  console.error(error);
                  Swal.fire('Error', 'Error de conexión', 'error');
              }
          }
        });
        
        window.switchPeriod = async (period) => {
            if (currentPeriod === period) return;
            currentPeriod = period;
            
            Swal.update({
                html: '<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-3xl text-indigo-500"></i><p class="mt-3 text-gray-500">Cargando datos...</p></div>',
                showConfirmButton: false
            });
            
            try {
                const newData = await loadStats(period);
                if (newData.success) {
                    currentData = newData;
                    Swal.update({
                        html: renderContent(),
                        showConfirmButton: true,
                        confirmButtonColor: '#4f46e5',
                        confirmButtonText: 'Cerrar'
                    });
                } else {
                    Swal.update({
                        html: '<div class="text-center py-4 text-red-500">Error al cargar los datos</div>',
                        showConfirmButton: true,
                        confirmButtonText: 'Cerrar'
                    });
                }
            } catch (error) {
                console.error(error);
                Swal.update({
                    html: '<div class="text-center py-4 text-red-500">Error de conexión</div>',
                    showConfirmButton: true,
                    confirmButtonText: 'Cerrar'
                });
            }
        };
    }
    
    async function changePassword() {
        const { value: formValues } = await Swal.fire({
            title: '<span class="text-lg font-bold text-gray-800">Cambiar Contraseña</span>',
            width: window.innerWidth < 640 ? '85%' : '400px', 
            padding: '1.25rem',
            buttonsStyling: false,
            customClass: {
                popup: 'rounded-[1.5rem] shadow-2xl', 
                htmlContainer: '!mx-0 !mt-4',
                actions: 'flex w-full gap-2 mt-5',
                confirmButton: 'flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl py-2.5 transition-colors',
                cancelButton: 'flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl py-2.5 transition-colors'
            },
            showCancelButton: true,
            confirmButtonText: 'Actualizar',
            cancelButtonText: 'Cancelar',
            html: `
                <div class="space-y-3 text-left">
                    <div class="relative">
                        <i class="fas fa-lock absolute left-3 top-3 text-gray-400 text-sm"></i>
                        <input type="password" id="currentPassword" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block pl-9 p-2.5 outline-none transition-all" placeholder="Contraseña actual" required>
                    </div>
                    <div class="relative">
                        <i class="fas fa-key absolute left-3 top-3 text-gray-400 text-sm"></i>
                        <input type="password" id="newPassword" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block pl-9 p-2.5 outline-none transition-all" placeholder="Nueva (mín. 4 caracteres)" required>
                    </div>
                    <div class="relative">
                        <i class="fas fa-check-double absolute left-3 top-3 text-gray-400 text-sm"></i>
                        <input type="password" id="confirmPassword" class="w-full bg-gray-50 border border-gray-200 text-gray-800 text-sm rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 block pl-9 p-2.5 outline-none transition-all" placeholder="Confirmar nueva" required>
                    </div>
                </div>
            `,
            focusConfirm: false,
            preConfirm: () => {
                const current = document.getElementById('currentPassword').value;
                const newPass = document.getElementById('newPassword').value;
                const confirm = document.getElementById('confirmPassword').value;
                
                if (!current || !newPass || !confirm) {
                    Swal.showValidationMessage('<span class="text-sm">Todos los campos son requeridos</span>');
                    return false;
                }
                
                if (newPass !== confirm) {
                    Swal.showValidationMessage('<span class="text-sm">Las contraseñas no coinciden</span>');
                    return false;
                }
                
                if (newPass.length < 4) {
                    Swal.showValidationMessage('<span class="text-sm">Mínimo 4 caracteres</span>');
                    return false;
                }
                
                return { currentPassword: current, newPassword: newPass };
            }
        });
        
        if (formValues) {
            Swal.fire({
                title: 'Actualizando...',
                html: '<i class="fas fa-spinner fa-spin text-3xl text-indigo-500 mt-2"></i>',
                showConfirmButton: false,
                allowOutsideClick: false,
                width: '250px',
                customClass: { popup: 'rounded-2xl' }
            });

            try {
                const res = await fetch('/restaurante/change-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formValues)
                });
                
                const data = await res.json();
                
                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '<span class="text-lg">¡Listo!</span>',
                        text: 'Contraseña actualizada',
                        confirmButtonText: 'Cerrar',
                        buttonsStyling: false,
                        width: '280px',
                        customClass: {
                            popup: 'rounded-[1.5rem]',
                            confirmButton: 'bg-indigo-600 text-white font-semibold rounded-xl px-6 py-2 w-full mt-2'
                        }
                    });
                } else {
                    Swal.fire('Error', data.error, 'error');
                }
            } catch (error) {
                Swal.fire('Error', 'Error de conexión', 'error');
            }
        }
    }
    
    function showHelp() {
        Swal.fire({
            title: 'Ayuda Rápida',
            html: `
                <div class="text-left space-y-2">
                    <p><i class="fas fa-users text-indigo-500"></i> <strong>Estadísticas:</strong> Toca un domiciliario para ver sus pedidos</p>
                    <p><i class="fas fa-key text-indigo-500"></i> <strong>Contraseña:</strong> cámbiala por seguridad</p>
                    <p><i class="fas fa-boxes text-indigo-500"></i> <strong>Escaneos:</strong> recarga cuando necesites más</p>
                </div>
            `,
            icon: 'info',
            confirmButtonColor: '#4f46e5'
        });
    }
    
    document.addEventListener('DOMContentLoaded', () => {
        loadAllDeliveryStats();
        
        const searchInput = document.getElementById('searchInput');
        if (searchInput) {
            searchInput.addEventListener('input', searchDeliveries);
        }
    });
    
    document.querySelectorAll('.btn-recargar').forEach(btn => {
        btn.onclick = function(e) {
            e.stopPropagation();
            let nombre = this.dataset.nombre;
            let url = `https://wa.me/573046793853?text=Hola,%20quiero%20hacer%20una%20recarga%20para%20el%20restaurante%20${encodeURIComponent(nombre)}`;
            window.open(url, '_blank');
        };
    });
</script>
</body>
</html>